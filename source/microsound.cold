			volumeDownPercent = integer0Return;
			jmp getStatementStart;
		}
		if(instructionStart == setImageInstruction){
			Image *pointer;
			switch name0Return over
				to 1: /*-*/ pointer = &muteImage; /*------*/ brk;
				to 2: /*-*/ pointer = &unmuteImage; /*----*/ brk;
				to 3: /*-*/ pointer = &incrementImage; /*-*/ brk;
				to 4: /*-*/ pointer = &decrementImage; /*-*/ brk;
				to 5: /*-*/ pointer = &overlayImage; /*---*/ brk;
				off: /*--*/ pointer = &alphaMapImage; /*--*/ brk;
			end
			if((*pointer).data){
				free((*pointer).data);
				popPointer((*pointer).dataToken);
			}
			image0Return.direction = (*pointer).direction;
			*pointer = image0Return;
			(*pointer).x = integer0Return;
			(*pointer).y = integer1Return;
			image0Return.data = NULL;
			image0Return.dataToken = 0;
			jmp getStatementStart;
		}
		if(instructionStart == setImageDirectionInstruction){
			Image *pointer;
			switch name0Return over
