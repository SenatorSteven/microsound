	endOfInstruction:{
		if((instructionStart == grabKeycodeInstruction or instructionStart == grabButtonInstruction) and name0Return == 1){
			const uint offset = instructionCurrent - instructionStart;
			if(instructionStart == grabKeycodeInstruction){
				instructionStart = executeGrabKeycodeSubInstruction;
			}else{
				instructionStart = executeGrabButtonSubInstruction;
			}
			instructionCurrent = instructionStart + offset;
			if(statementCurrent < statementWall){
				jmp switchInstructionLoop;
