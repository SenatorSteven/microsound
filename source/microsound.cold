			execute0Return = NULL;
			execute0Token = 0;
			if(name0Return <= lastGlobalCommand){
				const xcb_void_cookie_t cookie = xcb_grab_key_checked(connection, true, (*screen).root, nameList0Return, integer0Return, XCB_GRAB_MODE_ASYNC, XCB_GRAB_MODE_ASYNC);
