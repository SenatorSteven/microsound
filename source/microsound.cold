			, f("_NET_WM_MOVERESIZE_MOVE") \
			, f("_NET_WM_MOVERESIZE_MOVE_KEYBOARD") \
			, f("_NET_WM_MOVERESIZE_SIZE_TOPLEFT") \
			, f("_NET_WM_MOVERESIZE_SIZE_TOP") \
			, f("_NET_WM_MOVERESIZE_SIZE_TOPRIGHT") \
			, f("_NET_WM_MOVERESIZE_SIZE_RIGHT") \
			, f("_NET_WM_MOVERESIZE_SIZE_BOTTOMRIGHT") \
			, f("_NET_WM_MOVERESIZE_SIZE_BOTTOM") \
			, f("_NET_WM_MOVERESIZE_SIZE_BOTTOMLEFT") \
			, f("_NET_WM_MOVERESIZE_SIZE_LEFT") \
			, f("_NET_WM_MOVERESIZE_SIZE_KEYBOARD") \
			, f("_NET_WM_WINDOW_TYPE") \
			, f("_NET_WM_WINDOW_TYPE_DESKTOP") \
			, f("_NET_WM_WINDOW_TYPE_DOCK") \
			, f("_NET_WM_WINDOW_TYPE_TOOLBAR") \
			, f("_NET_WM_WINDOW_TYPE_MENU") \
			, f("_NET_WM_WINDOW_TYPE_UTILITY") \
			, f("_NET_WM_WINDOW_TYPE_SPLASH") \
			, f("_NET_WM_WINDOW_TYPE_DIALOG") \
			, f("_NET_WM_WINDOW_TYPE_NORMAL") \
			, f("_NET_WM_STATE") \
			, f("_NET_WM_STATE_HIDDEN") \
			, f("_NET_WM_STATE_MODAL") \
			, f("_NET_WM_STATE_STICKY") \
			, f("_NET_WM_STATE_MAXIMIZED_VERT") \
			, f("_NET_WM_STATE_MAXIMIZED_HORZ") \
			, f("_NET_WM_STATE_SHADED") \
			, f("_NET_WM_STATE_SKIP_TASKBAR") \
			, f("_NET_WM_STATE_SKIP_PAGER") \
			, f("_NET_WM_STATE_FULLSCREEN") \
			, f("_NET_WM_STATE_ABOVE") \
			, f("_NET_WM_STATE_BELOW") \
			, f("_NET_WM_STATE_DEMANDS_ATTENTION") \
			, f("_NET_WM_STATE_REMOVE") \
			, f("_NET_WM_STATE_ADD") \
			, f("_NET_WM_STATE_TOGGLE") \
			, f("_NET_WM_ACTION_MOVE") \
			, f("_NET_WM_ACTION_RESIZE") \
			, f("_NET_WM_ACTION_MINIMIZE") \
			, f("_NET_WM_ACTION_SHADE") \
			, f("_NET_WM_ACTION_STICK") \
			, f("_NET_WM_ACTION_MAXIMIZE_HORZ") \
			, f("_NET_WM_ACTION_MAXIMIZE_VERT") \
			, f("_NET_WM_ACTION_FULLSCREEN") \
			, f("_NET_WM_ACTION_CHANGE_DESKTOP") \
			, f("_NET_WM_ACTION_CLOSE") \
			, f("_NET_WM_TYPE_DESKTOP") \
			, f("_NET_WM_TYPE_DOCK") \
			, f("_NET_WM_TYPE_BELOW") \
			, f("_NET_WM_SYNC_REQUEST") \
			, f("_NET_WM_SYNC_REQUEST_COUNTER") \
		}
		const char *const atomNameStart[] = STRING(SELF);
		const char *const *atomNameCurrent = atomNameStart;
		const uint atomNameSizeStart[] = STRING(LITERAL_LENGTH);
		const uint *atomNameSizeCurrent = atomNameSizeStart;
		xcb_intern_atom_cookie_t cookieStart[ARRAY_SIZE(atomNameStart)];
		xcb_intern_atom_cookie_t *cookieCurrent = cookieStart;
		xcb_intern_atom_cookie_t *const cookieWall = cookieStart + ARRAY_SIZE(cookieStart);
		xcb_atom_t *atomCurrent = (void *)&atom;
		atomRequestLoop:{
			*cookieCurrent = xcb_intern_atom_unchecked(connection, false, *atomNameSizeCurrent, *atomNameCurrent);
			if(inc cookieCurrent < cookieWall){
				inc atomNameSizeCurrent;
				inc atomNameCurrent;
				jmp atomRequestLoop;
			}
			cookieCurrent = cookieStart;
			jmp atomReplyLoop;
		}
		atomReplyLoop:{
			xcb_intern_atom_reply_t *const reply = xcb_wait_for_reply(connection, *cookieCurrent, NULL);
			if(!reply){
				printError("%s%s: %s%s:%s %s%s%s\n", colorStart, programName, colorError, "atom error", colorEnd, "could not get the ", *(atomNameStart + (cookieCurrent - cookieStart)), " atom");
			}else{
				const uint replyToken = pushPointer(reply, "atom reply", iFree);
				*atomCurrent = (*reply).atom;
				free(reply);
				popPointer(replyToken);
			}
			if(inc cookieCurrent < cookieWall){
				inc atomCurrent;
				jmp atomReplyLoop;
			}
		}
		jmp storeMonitors;
		#undef  STRING
	}
	storeMonitors:{
		xcb_randr_get_monitors_reply_t *reply;
		Monitor *monitorCurrent;
		xcb_randr_monitor_info_iterator_t iterator;
		uint replyToken;
		struct{
			uint32 /*---------*/ backgroundColor;
			uint32 /*---------*/ borderColor;
			uint32 /*---------*/ overrideRedirect;
			uint32 /*---------*/ eventMask;
			xcb_colormap_t /*-*/ colormap;
		} valueList;
		if(!(reply = xcb_wait_for_reply(connection, xcb_randr_get_monitors_unchecked(connection, (*screen).root, true), NULL))){
			printTitledError("xcb reply error", "could not get monitors");
			monitorAllocated = 1;
			jmp storeMonitorsExit;
		}
		replyToken = pushPointer(reply, "monitor reply", iFree);
		monitorAllocated = (*reply).nMonitors;
		if(!(monitorData = malloc(monitorAllocated * sizeof(Monitor)))){
			printTitledError("data allocation error", "could not store monitor data");
			free(reply);
			jmp storeMonitorsExit;
		}
		monitorDataToken = pushPointer(monitorData, "monitor pointer", iFree);
		iterator = xcb_randr_get_monitors_monitors_iterator(reply);
		monitorStart = monitorData;
		monitorCurrent = monitorStart;
		monitorWall = monitorStart + monitorAllocated;
		valueList.backgroundColor = 0x00000000;
		valueList.borderColor = 0x00000000;
		valueList.overrideRedirect = true;
		valueList.eventMask = XCB_EVENT_MASK_EXPOSURE;
		valueList.colormap = colormap;
		jmp storeMonitorLoop;
		storeMonitorLoop:{
			if(monitorCurrent < monitorWall){
				const xcb_randr_monitor_info_t *const data = iterator.data;
				const int x = (*data).x;
				const int y = (*data).y;
				const int w = (*data).width;
				const int h = (*data).height;
				if(monitorCurrent > monitorStart){
					const Monitor *const wall = monitorCurrent;
					const Monitor *current = monitorStart;
					removeSameMonitorLoop:{
						if(current < wall){
							if((*current).leftX == x and (*current).topY == y and (*current).w == w and (*current).h == h){
								dec monitorAllocated;
								dec monitorWall;
								xcb_randr_monitor_info_next(&iterator);
								jmp storeMonitorLoop;
							}
							inc current;
							jmp removeSameMonitorLoop;
						}
					}
				}
				(*monitorCurrent).leftX = x;
				(*monitorCurrent).topY = y;
				(*monitorCurrent).rightX = x + w;
				(*monitorCurrent).bottomY = y + h;
				(*monitorCurrent).w = w;
				(*monitorCurrent).h = h;
				(*monitorCurrent).window = xcb_generate_id(connection);
				(*monitorCurrent).gc = xcb_generate_id(connection);
				(*monitorCurrent).windowIsMapped = false;
				xcb_create_window(connection, depth, (*monitorCurrent).window, (*screen).root, 0, 0, 1, 1, 0, XCB_WINDOW_CLASS_INPUT_OUTPUT, visual, XCB_CW_BACK_PIXEL | XCB_CW_BORDER_PIXEL | XCB_CW_OVERRIDE_REDIRECT | XCB_CW_EVENT_MASK | XCB_CW_COLORMAP, &valueList);
				xcb_create_gc(connection, (*monitorCurrent).gc, (*monitorCurrent).window, XCB_NONE, NULL);
				xcb_randr_monitor_info_next(&iterator);
				inc monitorCurrent;
				jmp storeMonitorLoop;
			}
			free(reply);
			popPointer(replyToken);
			placeMonitorWindows();
			jmp trimMonitorMemory;
		}
		trimMonitorMemory:{
			void *temp;
			if(!(temp = realloc(monitorData, monitorAllocated * sizeof(Monitor)))){
				jmp storeMonitorsExit;
			}
			updatePointer(monitorDataToken, temp);
			monitorData = temp;
			monitorStart = monitorData;
			monitorWall = monitorStart + monitorAllocated;
			jmp storeMonitorsExit;
		}
	}
	storeMonitorsExit:{
		if(event){
			jmp eventLoop;
		}
		jmp setupReadConfig;
	}
	setupReadConfig:{
		bulkInsertString(&globalScopesInstructionRoot, globalScopesInstructionList);
		bulkInsertString(&globalInstructionRoot, globalInstructionList);
		bulkInsertString(&scope1ScopeInstructionRoot, scope1ScopeInstructionList);
		bulkInsertString(&imageRoot, imageList);
		bulkInsertString(&modifierRoot, modifierList);
		bulkInsertString(&macroRoot, macroList);
		bulkInsertString(&commandRoot, commandList);
		jmp readConfig;
	}
	readConfig:{
		displaySimpleConfigErrors = true;
		offsetX = 0;
		offsetY = 0;
		centeredX = false;
		centeredY = false;
		width = 0;
		height = 0;
		whichMonitor = NoneWhichMonitor;
		duration = 0;
		volumeDownPercent = 0;
		volumeUpPercent = 0;
		muteImage.data = NULL;
		muteImage.dataToken = 0;
		muteImage.direction = UP_LEFT_IMAGE_DIRECTION;
		unmuteImage.data = NULL;
		unmuteImage.dataToken = 0;
		unmuteImage.direction = UP_LEFT_IMAGE_DIRECTION;
		incrementImage.data = NULL;
		incrementImage.dataToken = 0;
		incrementImage.direction = UP_LEFT_IMAGE_DIRECTION;
		decrementImage.data = NULL;
		decrementImage.dataToken = 0;
		decrementImage.direction = UP_LEFT_IMAGE_DIRECTION;
		overlayImage.data = NULL;
		overlayImage.dataToken = 0;
		overlayImage.direction = UP_LEFT_IMAGE_DIRECTION;
		alphaMapImage.data = NULL;
		alphaMapImage.dataToken = 0;
		alphaMapImage.direction = UP_LEFT_IMAGE_DIRECTION;
		readConfig(true, configPath, fgetc);
		jmp postReadConfig;
	}
	postReadConfig:{
		placeMonitorWindows();









#define BOX_SIZE /*-*/ (111)



		intermediateData   = malloc(width * height * sizeof(uint32));
		data               = malloc(width * height * sizeof(uint32));

		kernelColumnRStart = malloc(BOX_SIZE + 2 * width * sizeof(uint32));
		kernelColumnGStart = malloc(BOX_SIZE + 2 * width * sizeof(uint32));
		kernelColumnBStart = malloc(BOX_SIZE + 2 * width * sizeof(uint32));

		pixelRStart        = malloc(BOX_SIZE + 2 * width * height * sizeof(uint32));
		pixelGStart        = malloc(BOX_SIZE + 2 * width * height * sizeof(uint32));
		pixelBStart        = malloc(BOX_SIZE + 2 * width * height * sizeof(uint32));









		jmp eventLoopCheckShortcuts;
	}
	eventLoopCheckShortcuts:{
		xcb_flush(connection);
		free(event);
		popPointer(eventToken);
		eventToken = 0;
		if(keyPressNextOffset){
			event = NULL;
			jmp keyPressEvent;
		}
		if(buttonPressNextOffset){
			event = NULL;
			jmp buttonPressEvent;
		}
		jmp waitForEvent;
	}
	eventLoop:{
		xcb_flush(connection);
		free(event);
		popPointer(eventToken);
		eventToken = 0;
		jmp waitForEvent;
	}
	waitForEvent:{
		acceptingShared = true;
		if((event = xcb_wait_for_event(connection))){
			acceptingShared = false;
			eventToken = pushPointer(event, "first event pointer", iFree);
			jmp switchEvent;
		}
		acceptingShared = false;
		if(xcb_connection_has_error(connection)){
			printConnectionError();
			jmp mainEmergencyExit;
		}
		jmp waitForEvent;
	}
	switchEvent:{
		#define XCB_ONE /*-*/ (1)
		printXEvent();
		switch (*event).response_type & ~b(10000000) over
			to XCB_NONE: /*--------------*/ jmp errorEvent;
			to XCB_ONE: /*---------------*/ jmp impossibleEvent;
			to XCB_KEY_PRESS: /*---------*/ jmp keyPressEvent;
			to XCB_KEY_RELEASE: /*-------*/ jmp eventLoop;
			to XCB_BUTTON_PRESS: /*------*/ jmp buttonPressEvent;
			to XCB_BUTTON_RELEASE: /*----*/ jmp eventLoop;
			to XCB_MOTION_NOTIFY: /*-----*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_ENTER_NOTIFY: /*------*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_LEAVE_NOTIFY: /*------*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_FOCUS_IN: /*----------*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_FOCUS_OUT: /*---------*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_KEYMAP_NOTIFY: /*-----*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_EXPOSE: /*------------*/ jmp exposeEvent;
			to XCB_GRAPHICS_EXPOSURE: /*-*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_NO_EXPOSURE: /*-------*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_VISIBILITY_NOTIFY: /*-*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_CREATE_NOTIFY: /*-----*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_DESTROY_NOTIFY: /*----*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_UNMAP_NOTIFY: /*------*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_MAP_NOTIFY: /*--------*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_MAP_REQUEST: /*-------*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_REPARENT_NOTIFY: /*---*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_CONFIGURE_NOTIFY: /*--*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_CONFIGURE_REQUEST: /*-*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_GRAVITY_NOTIFY: /*----*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_RESIZE_REQUEST: /*----*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_CIRCULATE_NOTIFY: /*--*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_CIRCULATE_REQUEST: /*-*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_PROPERTY_NOTIFY: /*---*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_SELECTION_CLEAR: /*---*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_SELECTION_REQUEST: /*-*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_SELECTION_NOTIFY: /*--*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_COLORMAP_NOTIFY: /*---*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_CLIENT_MESSAGE: /*----*/ /*----------------*/ jmp unexpectedEvent;
			to XCB_MAPPING_NOTIFY: /*----*/ jmp eventLoop;
			to XCB_GE_GENERIC: /*--------*/ jmp unexpectedEvent;
			off: /*----------------------*/ jmp extensionEvent;
		end
		#undef  XCB_ONE
	}
	errorEvent:{
		printErrorEvent(event);
		jmp eventLoop;
	}
	impossibleEvent:{
		printTitledValuedError("X event error", "impossible event with type", (*event).response_type & ~b(10000000));
		jmp eventLoop;
	}
	keyPressEvent:{
		#define event /*-*/ ((xcb_key_press_event_t *)event)
		const ModifierNode *current = keycodeShortcut.modifierData;
		uint8 code = keyPressCode;
		uint16 modifier = keyPressModifier;
		uint offset = keyPressNextOffset;
		if(!keyPressNextOffset){
			code = (*event).detail;
			modifier = (*event).state;
			offset = *(keycodeShortcut.codeListStart + code);
		}
		jmp findKeycodeModifierLoop;
		findKeycodeModifierLoop:{
			if(offset){
				current += offset;
				if((*current).modifier == modifier){
					command = (*current).command;
					keyPressCode = code;
					keyPressModifier = modifier;
					executeString = (*current).string;
					if((*current).nextOffset){
						keyPressNextOffset = current - keycodeShortcut.modifierData + (*current).nextOffset;
						jmp switchCommand;
					}
					keyPressNextOffset = 0;
					jmp switchCommand;
				}
				offset = (*current).nextOffset;
				jmp findKeycodeModifierLoop;
			}
		}
		keyPressNextOffset = 0;
		jmp eventLoop;
		#undef  event
	}
	buttonPressEvent:{
		#define event /*-*/ ((xcb_button_press_event_t *)event)
		const ModifierNode *current = buttonShortcut.modifierData;
		uint8 code = buttonPressCode;
		uint16 modifier = buttonPressModifier;
		uint offset = buttonPressNextOffset;
		if(!buttonPressNextOffset){
			code = (*event).detail;
			modifier = (*event).state;
			offset = *(buttonShortcut.codeListStart + code);
		}
		jmp findButtoncodeModifierLoop;
		findButtoncodeModifierLoop:{
			if(offset){
				current += offset;
				if((*current).modifier == modifier){
					command = (*current).command;
					buttonPressCode = code;
					buttonPressModifier = modifier;
					executeString = (*current).string;
					if((*current).nextOffset){
						buttonPressNextOffset = current - buttonShortcut.modifierData + (*current).nextOffset;
						jmp switchCommand;
					}
					buttonPressNextOffset = 0;
					jmp switchCommand;
				}
				offset = (*current).nextOffset;
				jmp findButtoncodeModifierLoop;
			}
		}
		buttonPressNextOffset = 0;
		jmp eventLoop;
		#undef  event
	}
	exposeEvent:{
		#define event /*-*/ ((xcb_expose_event_t *)event)
		const xcb_window_t window = (*event).window;
		struct timespec t1;
		uint64 milliseconds;
		Monitor *monitorCurrent = monitorStart;
		clock_gettime(CLOCK_MONOTONIC_RAW, &t1);
		milliseconds = ((t1.tv_sec - t0.tv_sec) * 1000000000 + (t1.tv_nsec - t0.tv_nsec)) / 1000000;
		if(milliseconds >= duration){
			findUnmapExposedWindowLoop:{
				if((*monitorCurrent).window == window){
					xcb_unmap_window(connection, window);
					(*monitorCurrent).windowIsMapped = false;
					jmp eventLoop;
				}
				if(inc monitorCurrent < monitorWall){
					jmp findUnmapExposedWindowLoop;
				}
			}
			jmp eventLoop;
		}
		findExposedWindowLoop:{
			if((*monitorCurrent).window == window){
				const int x = (*monitorCurrent).windowX;
				const int y = (*monitorCurrent).windowY;
				bool localMute;
				int localOldVolume;
				int localVolume;
				xcb_get_image_reply_t *reply;
				Image *usedImage;
				Image finalImage;
				exposeEvent.window = window;
				xcb_send_event(connection, false, window, XCB_EVENT_MASK_EXPOSURE, &exposeEvent);
				xcb_flush(connection);









				/*! probably add a little block to absolutely get the right mute and volume values here, and then let the other thread edit these values */



				localMute = mute;
				localOldVolume = rangedOldVolume;
				localVolume = rangedVolume;









				finalImage.x = 0;
				finalImage.y = 0;
				finalImage.width = width;
				finalImage.height = height;
				finalImage.size = width * height * 4;
				finalImage.data = data;
				if(localMute){
					usedImage = &muteImage;
				}elif(localVolume == localOldVolume){
					usedImage = &unmuteImage;
				}elif(localVolume > localOldVolume){
					usedImage = &incrementImage;
				}else{
					usedImage = &decrementImage;
				}
				switch blurUsed over
					to TWO_PASS_BOX_BLUR:{
						if((reply = xcb_wait_for_reply(connection, xcb_get_image(connection, XCB_IMAGE_FORMAT_Z_PIXMAP, (*screen).root, x, y - height, width, height, -1), NULL))){
							const uint token = pushPointer(reply, "screenshot reply", iFree);
							doubleBoxBlur(width, height, (void *)xcb_get_image_data(reply), intermediateData, data, BOX_SIZE);
							free(reply);
							popPointer(token);
						}
						overlay((*usedImage).direction, usedImage, &finalImage);
						brk;
					}
					off:{
						if(!copyImage(usedImage, &finalImage)){
							jmp eventLoop;
						}
						brk;
					}
				end
				if(overlayImage.data){
					const int height = overlayImage.height;
					overlayImage.height = height * localVolume / 100;
					overlay(overlayImage.direction, &overlayImage, &finalImage);
					overlayImage.height = height;
				}
				if(alphaMapImage.data){
					alphaMap(alphaMapImage, finalImage);
				}
				xcb_put_image(connection, XCB_IMAGE_FORMAT_Z_PIXMAP, window, (*monitorCurrent).gc, finalImage.width, finalImage.height, finalImage.x, finalImage.y, 0, depth, finalImage.size, (void *)finalImage.data);
				if(blurUsed == NONE_BLUR){
					free(finalImage.data);
					popPointer(finalImage.dataToken);
				}
				jmp eventLoop;
			}
			if(inc monitorCurrent < monitorWall){
				jmp findExposedWindowLoop;
			}
		}
		jmp eventLoop;
		#undef  event
	}
	extensionEvent:{
		const uint8 eventType = (*event).response_type & ~b(10000000);
		if(eventType == randrBaseEvent + XCB_RANDR_SCREEN_CHANGE_NOTIFY){
			jmp randrEvent;
		}
		if(eventType == randrBaseError){
			jmp randrError;
		}
		jmp unhandledEvent;
	}
	randrEvent:{
		Monitor *monitorCurrent = monitorStart;
		jmp freeMonitorResourcesLoop;
		freeMonitorResourcesLoop:{
			xcb_destroy_window(connection, (*monitorCurrent).window);
			xcb_free_gc(connection, (*monitorCurrent).gc);
			if(inc monitorCurrent < monitorWall){
				jmp freeMonitorResourcesLoop;
			}
			free(monitorData);
			popPointer(monitorDataToken);
			jmp storeMonitors;
		}
	}
	randrError:{
		printErrorEvent(event);
		jmp eventLoop;
	}
	unhandledEvent:{
		printTitledValuedError("X event error", "unhandled event with type", (*event).response_type & ~b(10000000));
		jmp eventLoop;
	}
	unexpectedEvent:{
		printUnexpectedEvent();
		jmp eventLoop;
	}
	switchCommand: switch command over
		to NONE_COMMAND: /*--------*/ jmp eventLoopCheckShortcuts;
		to EXECUTE_COMMAND: /*-----*/ jmp executeCommand;
		to VOLUME_UP_COMMAND: /*---*/ jmp volumeUpCommand;
		to VOLUME_DOWN_COMMAND: /*-*/ jmp volumeDownCommand;
		to MUTE_COMMAND: /*--------*/ jmp muteCommand;
		to RESTART_COMMAND: /*-----*/ jmp restartCommand;
		to EXIT_COMMAND: /*--------*/ jmp exitCommand;
		off: /*--------------------*/ jmp unrecognizedCommand;
	end
	executeCommand:{
		exec(executeString);
		jmp eventLoopCheckShortcuts;
	}
	volumeUpCommand:{
		if(!pulseaudioEvent){
			pulseaudioEvent = VOLUME_UP_PULSEAUDIO_EVENT;
			pa_threaded_mainloop_signal(mainloop, 0);
		}
		jmp eventLoopCheckShortcuts;
	}
	volumeDownCommand:{
		if(!pulseaudioEvent){
			pulseaudioEvent = VOLUME_DOWN_PULSEAUDIO_EVENT;
			pa_threaded_mainloop_signal(mainloop, 0);
		}
		jmp eventLoopCheckShortcuts;
	}
	muteCommand:{
		if(!pulseaudioEvent){
			pulseaudioEvent = MUTE_PULSEAUDIO_EVENT;
			pa_threaded_mainloop_signal(mainloop, 0);
		}
		jmp eventLoopCheckShortcuts;
	}
	restartCommand:{
		ungrabShortcuts();
		resetShortcutRoot(&buttonShortcut);
		resetShortcutRoot(&keycodeShortcut);
		jmp readConfig;
	}
	exitCommand:{
		jmp mainEmergencyExit;
	}
	unrecognizedCommand:{
		printTitledValuedError("command error", "executed unrecognized command with type", command);
		jmp eventLoopCheckShortcuts;
	}
	mainEmergencyExit:{
		cancelThreads();
		if(mainloop){
			pa_threaded_mainloop_stop(mainloop);
		}
		free(event);
		popPointer(eventToken);
		free(monitorData);
		popPointer(monitorDataToken);
		ungrabShortcuts();
		xcb_disconnect(connection);
		popPointer(connectionToken);
		deleteShortcutRoot(&buttonShortcut);
		deleteShortcutRoot(&keycodeShortcut);
		deleteStringRoot(&commandRoot);
		deleteStringRoot(&macroRoot);
		deleteStringRoot(&modifierRoot);
		deleteStringRoot(&imageRoot);
		deleteStringRoot(&scope1ScopeInstructionRoot);
		deleteStringRoot(&globalInstructionRoot);
		deleteStringRoot(&globalScopesInstructionRoot);
		if(dynamicDataSegment.allocated > 1){
			printError("%s%s: %s%s:%s %s", colorStart, programName, colorError, "warning", colorEnd, "program exited with unaccounted for data pointers, namely: ");
			printUnaccountedForPointers(dynamicDataSegment.data + 1, dynamicDataSegment.data + dynamicDataSegment.allocated);
		}
		cleanup();
		ret 0;
	}
}
QUIT(){
	const char *message;
	const Pointer *start;
	const Pointer *current;
	const Pointer *wall;
	jmp evaluateHandlerAvailability;
	evaluateHandlerAvailability:{
		if(quitting){
			if(signal != SIGSEGV){
				ret;
			}
			printTitledNamedError("quitting error", "could not free", labelExamined);
			jmp exit;
		}
		if(processingSignal and signal != SIGINT){
			ret;
		}
		processingSignal = true;
		jmp findSignal;
	}
	findSignal: switch signal over
		to SIGABRT: /*-*/ message = "aborted"; /*--------------*/ jmp exitWithError;
		to SIGBUS: /*--*/ message = "hardware faulted"; /*-----*/ jmp exitWithError;
		to SIGFPE: /*--*/ message = "programmer math'd up"; /*-*/ jmp exitWithError;
		to SIGILL: /*--*/ message = "executable corrupted"; /*-*/ jmp exitWithError;
		to SIGINT: /*--*/ message = "interrupted"; /*----------*/ jmp exitWithError;
		to SIGQUIT: /*-*/ message = "voluntarily quitted"; /*--*/ jmp exitWithError;
		to SIGSEGV: /*-*/ message = "segmentation faulted"; /*-*/ jmp exitWithError;
		to SIGTERM: /*-*/ message = "terminated"; /*-----------*/ jmp exitWithError;
		to SIGTRAP: /*-*/ message = "trapped"; /*--------------*/ jmp exitWithError;
		to SIGUSR1: /*-*/ /*-----------------------------------*/ jmp handleIPCMessage;
		to SIGUSR2: /*-*/ /*-----------------------------------*/ jmp handleIPCProtocolError;
		off: /*--------*/ message = "unhandled signal"; /*-----*/ jmp exitWithError;
	end
	handleIPCMessage:{
		if(!acceptingShared){
			sharedHasArrived = true;
			ret;
		}
		sharedHasArrived = false;
		acceptingShared = false;
		sharedCurrent = sharedStart;
		readConfig(false, "transmitter", getSharedCharacter);
		*sharedStart = '\0';
		acceptingShared = true;
		processingSignal = false;
		ret;
	}
	handleIPCProtocolError:{
		shmDisconnect();
		shmConnect();
		processingSignal = false;
		ret;
	}
	exitWithError:{
		quitting = true;
		printTitledError("signal received", message);
		cancelThreads();
		if(dynamicDataSegment.allocated <= 1){
			jmp exit;
		}
		start = dynamicDataSegment.data;
		current = start + 1;
		wall = start + dynamicDataSegment.allocated;
		if(signal == SIGSEGV){
			printError("%s%s: %spointers at time of error:%s ", colorStart, programName, colorError, colorEnd);
			if(dynamicDataSegment.allocated > 1){
				jmp printPointedVariables;
			}
			printError("none\n");
		}
		jmp freePointedVariablesLoop;
	}
	printPointedVariables:{
		printUnaccountedForPointers(current, wall);
		current = start + 1;
		jmp freePointedVariablesLoop;
	}
	freePointedVariablesLoop:{
		if((*current).data){
			labelExamined = (*current).label;
			(*current).free((*current).data);
		}
		if(inc current < wall){
			jmp freePointedVariablesLoop;
		}
		jmp exit;
	}
	exit:{
		cleanup();
		exit(EXIT_SUCCESS);
	}
}
GETSHAREDCHARACTER(){
	const int c = *sharedCurrent;
	(void)configFile;
	inc sharedCurrent;
	ret c;
}
INITMEMORYMANAGER(){
	#define DYNAMIC_DATA_SEGMENT_BLOCK_SIZE /*-*/ (16)
	#define s /*-------------------------------*/ (dynamicDataSegment)
	s.data = malloc(DYNAMIC_DATA_SEGMENT_BLOCK_SIZE * sizeof(Pointer));
	s.size = DYNAMIC_DATA_SEGMENT_BLOCK_SIZE;
	s.allocated = 1;
	if(!s.data){
		printTitledError("memory allocation error", "could not allocate memory for a string tree");
		ret false;
	}
	(*s.data).data = (void *)1;
	ret true;
}
PUSHPOINTER(){
	uint32 token;
	jmp checkPointerValidity;
	checkPointerValidity:{
		if(!pointer){
			ret 0;
		}
		if(pthread_mutex_lock(&memorySegmentLock) != PTHREAD_MUTEX_LOCK_SUCCESS){
			printTitledError("pthread error", "could not lock pushPointer() mutex");
			ret 0;
		}
		jmp appendPointer;
	}
	appendPointer:{
		token = s.allocated;
		if(token == s.size){
			void *temp;
			s.size += DYNAMIC_DATA_SEGMENT_BLOCK_SIZE;
			if(!(temp = realloc(s.data, s.size * sizeof(Pointer)))){
				token = 0;
				jmp emergencyExit;
			}
			s.data = temp;
		}
		(*(s.data + token)).label = label;
		(*(s.data + token)).data = pointer;
		(*(s.data + token)).token = token;
		(*(s.data + token)).free = freeFunction;
		inc s.allocated;
		jmp emergencyExit;
	}
	emergencyExit:{
		if(pthread_mutex_unlock(&memorySegmentLock) != PTHREAD_MUTEX_UNLOCK_SUCCESS){
			printTitledError("pthread error", "could not unlock pushPointer() mutex");
		}
		ret token;
	}
}
POPPOINTER(){
	jmp checkTokenValidity;
	checkTokenValidity:{
		if(!token){
			ret;
		}
		if(pthread_mutex_lock(&memorySegmentLock) != PTHREAD_MUTEX_LOCK_SUCCESS){
			printTitledError("pthread error", "could not lock popPointer() mutex");
			ret;
		}
		(*(s.data + token)).data = NULL;
		jmp trimSegment;
	}
	trimSegment:{
		if(!(*(s.data + s.allocated - 1)).data){
			dec s.allocated;
			jmp trimSegment;
		}
		if(pthread_mutex_unlock(&memorySegmentLock) != PTHREAD_MUTEX_UNLOCK_SUCCESS){
			printTitledError("pthread error", "could not unlock popPointer() mutex");
		}
		ret;
	}
}
UPDATEPOINTER(){
	if(pthread_mutex_lock(&memorySegmentLock) != PTHREAD_MUTEX_UNLOCK_SUCCESS){
		printTitledError("pthread error", "could not lock updatePointer() mutex");
		ret;
	}
	if(token){
		(*(s.data + token)).data = pointer;
	}
	if(pthread_mutex_unlock(&memorySegmentLock) != PTHREAD_MUTEX_UNLOCK_SUCCESS){
		printTitledError("pthread error", "could not unlock updatePointer() mutex");
	}
	ret;
}
DELETEMEMORYMANAGER(){
	free(s.data);
	ret;
}
IFREE(){
	free(pointer);
	ret 0;
}
ISHMCTL(){
	shmctl((uint64)pointer, IPC_RMID, NULL);
	ret 0;
}
IXCBDISCONNECT(){
	xcb_disconnect(pointer);
	ret 0;
	#undef  s
	#undef  DYNAMIC_DATA_SEGMENT_BLOCK_SIZE
}
SHMCONNECT(){
	#define SHM_KEY /*--------*/ (((s.st_dev << 20) & 0xfff00000) | ((s.st_ino << 8) & 0x000fff00) | 0x00000045)
	#define SHARED_SIZE /*----*/ (65536)
	#define SHM_NONE /*-------*/ (0)
	#define STAT_FAILURE /*---*/ (-1)
	#define SHMGET_FAILURE /*-*/ (-1)
	#define SHMAT_FAILURE /*--*/ (-1)
	#define SHMCTL_FAILURE /*-*/ (-1)
	#define SHMDT_FAILURE /*--*/ (-1)
	def struct stat /*-*/ Stat;
	FILE *file;
	Stat s;
	shmidToken = 0;
	sharedStartToken = 0;
	jmp createKeyFile;
	createKeyFile:{
		uint fileToken;
		if(!(file = fopen(STAT_PATH, "w")) and !(file = fopen(STAT_PATH, "r"))){
			printError("%s: could neither create nor read %s file\n", programName, STAT_PATH);
			ret;
		}
		fileToken = pushPointer(file, "shm file", fclose);
		fprintf(file, "%u\n", getpid());
		fclose(file);
		popPointer(fileToken);
		jmp getKeyFileStat;
	}
	getKeyFileStat:{
		if(stat(STAT_PATH, &s) == STAT_FAILURE){
			printError("%s: could not generate shared memory key\n", programName);
			ret;
		}
		jmp generateSharedMemoryID;
	}
	generateSharedMemoryID:{
		if((shmid = shmget(SHM_KEY, SHARED_SIZE, 0600 | IPC_CREAT)) == SHMGET_FAILURE){
			printError("%s: could not create shared memory segment\n", programName);
			ret;
		}
		shmidToken = pushPointer((void *)(uint64)shmid, "shm id", ishmctl);
		jmp attachToSharedMemory;
	}
	attachToSharedMemory:{
		if((sharedStart = shmat(shmid, NULL, SHM_NONE)) == (void *)SHMAT_FAILURE){
			printError("%s: could not attach to shared memory\n", programName);
			ret;
		}
		sharedStartToken = pushPointer(sharedStart, "shared memory pointer", shmdt);
		*sharedStart = '\0';
		ret;
	}
}
SHMDISCONNECT(){
	jmp markForDeletion;
	markForDeletion:{
		if(shmid != SHMGET_FAILURE and shmctl(shmid, IPC_RMID, NULL) == SHMCTL_FAILURE){
			printError("%s: could not mark shared memory for deletion\n", programName);
			ret;
		}
		popPointer(shmidToken);
		jmp detach;
	}
	detach:{
		if(sharedStart != (void *)SHMAT_FAILURE and shmdt(sharedStart) == SHMDT_FAILURE){
			printError("%s: could not detach from shared memory\n", programName);
			ret;
		}
		popPointer(sharedStartToken);
		ret;
	}
	#undef  SHMDT_FAILURE
	#undef  SHMCTL_FAILURE
	#undef  SHMAT_FAILURE
	#undef  SHMGET_FAILURE
	#undef  STAT_FAILURE
	#undef  SHM_NONE
	#undef  SHARED_SIZE
	#undef  SHM_KEY
}
IDENTIFYARGUMENT(){
	if(*p != '-') jmp findValueArgument;
	inc p;
	if(*p != '-') jmp findShortArgument;
	inc p;
	jmp findLongArgument;
	findValueArgument:{
		if(insensitiveStringCompare("stdout", p)) /*-*/ ret STDOUT_ARGUMENT;
		if(insensitiveStringCompare("stderr", p)) /*-*/ ret STDERR_ARGUMENT;
		/*-------------------------------------------*/ ret UNRECOGNIZED_ARGUMENT;
	}
	findShortArgument:{
		if(insensitiveStringCompare("h", p)) /*------*/ ret HELP_ARGUMENT;
		if(insensitiveStringCompare("c", p)) /*------*/ ret CONFIG_ARGUMENT;
		if(insensitiveStringCompare("e", p)) /*------*/ ret ERROR_ARGUMENT;
		if(insensitiveStringCompare("s", p)) /*------*/ ret SERVER_ARGUMENT;
		/*-------------------------------------------*/ ret UNRECOGNIZED_ARGUMENT;
	}
	findLongArgument:{
		if(insensitiveStringCompare("help", p)) /*---*/ ret HELP_ARGUMENT;
		if(insensitiveStringCompare("config", p)) /*-*/ ret CONFIG_ARGUMENT;
		if(insensitiveStringCompare("error", p)) /*--*/ ret ERROR_ARGUMENT;
		if(insensitiveStringCompare("server", p)) /*-*/ ret SERVER_ARGUMENT;
		/*-------------------------------------------*/ ret UNRECOGNIZED_ARGUMENT;
	}
}
INSENSITIVESTRINGCOMPARE(){
	compareCharacterLoop:{
		char c1 = *s1;
		c1 |= 32 * (c1 >= 'A' and c1 <= 'Z');
		if(*s0 != c1) /*-*/ ret false;
		if(!c1) /*-------*/ ret true;
		inc s0;
		inc s1;
		jmp compareCharacterLoop;
	}
}
SENSITIVESTRINGCOMPARE(){
	compareCharacterLoop:{
		if(*s0 != *s1) /*-*/ ret false;
		if(!*s0) /*-------*/ ret true;
		inc s0;
		inc s1;
		jmp compareCharacterLoop;
	}
}



























/*!
	do include the pushPointer() mechanics here

	mainloop and context popping causes error
*/

#define IMAINLOOPFREE() /*----------*/ local int iMainloopFree(pa_threaded_mainloop *const mainloop)
#define ICONTEXTDISCONNECTFREE() /*-*/ local int iContextDisconnectFree(pa_context *const context)
#define IOPERATIONUNREF() /*--------*/ local int iOperationUnref(pa_operation *const operation)

IMAINLOOPFREE(){
	pa_threaded_mainloop_free(mainloop);
	ret 0;
}
ICONTEXTDISCONNECTFREE(){
	pa_context_disconnect(context);
	pa_context_unref(context);
	ret 0;
}
IOPERATIONUNREF(){
	pa_operation_unref(operation);
	ret 0;
}
PULSEAUDIOMAIN(){
	#define PA_CONTEXT_NONE /*-*/ (0)
	uint mainloopToken = 0;
	uint contextToken = 0;
	uint ready = PA_CONTEXT_NONE;
	(void)arg;
	mainloop = NULL;
	context = NULL;
	jmp establishServerConnection;
	establishServerConnection:{
		if(!(mainloop = pa_threaded_mainloop_new())){
			jmp emergencyExit;
		}



		pa_threaded_mainloop_lock(mainloop);
		pa_threaded_mainloop_start(mainloop);



		if(!(context = pa_context_new_with_proplist(pa_threaded_mainloop_get_api(mainloop), PROGRAM_NAME, NULL))){
			jmp emergencyExit;
		}



		if(pa_context_connect(context, NULL, PA_CONTEXT_NOFLAGS, NULL) == -1){
			printTitledError("fatal pulseaudio error", "could not connect to pulseaudio");
			jmp emergencyExit;
		}



		pa_context_set_state_callback(context, getState, &ready);



/*!
		mainloopToken = pushPointer(mainloop, "pulseaudio main loop pointer", iMainloopFree);
		contextToken = pushPointer(context, "pulseaudio context pointer", iContextDisconnectFree);
*/



		pa_threaded_mainloop_unlock(mainloop);



		jmp checkContextReadinessLoop;
	}
	checkContextReadinessLoop:{



		pa_threaded_mainloop_wait(mainloop);



		switch ready over
			to PA_CONTEXT_NONE: /*-------*/ jmp checkContextReadinessLoop;
			to PA_CONTEXT_READY: /*------*/ jmp getSinkInformation;
			to PA_CONTEXT_TERMINATED: /*-*/ jmp contextTerminated;
			off: /*----------------------*/ jmp contextFailed;
		end
	}
	contextTerminated:{
		printTitledError("fatal pulseaudio error", "context terminated");
		jmp emergencyExit;
	}
	contextFailed:{
		printTitledError("fatal pulseaudio error", "context failed");
		jmp emergencyExit;
	}
	getSinkInformation:{



		pa_operation *operation = pa_context_get_server_info(context, getSinkName, NULL);
		uint token = pushPointer(operation, "pulseaudio server info operation", iOperationUnref);
		pa_operation_unref(operation);
		popPointer(token);



		operation = pa_context_get_sink_info_by_name(context, defaultSinkName, firstGetSinkInfoCallback, NULL);
		token = pushPointer(operation, "pulseaudio default sink info operation", iOperationUnref);
		pa_operation_unref(operation);
		popPointer(token);



		jmp subscribeToEvents;
	}
	subscribeToEvents:{



		pa_operation *const operation = pa_context_subscribe(context, PA_SUBSCRIPTION_MASK_SINK, NULL, NULL);
		uint token = pushPointer(operation, "pulseaudio subscription operation", iOperationUnref);
		pa_context_set_subscribe_callback(context, subscribeCallback, NULL);
		pa_operation_unref(operation);
		popPointer(token);



		pa_threaded_mainloop_lock(mainloop);



		jmp eventLoop;
	}
	eventLoop:{
		pulseaudioEvent = NONE_PULSEAUDIO_EVENT;
		pa_threaded_mainloop_wait(mainloop);
		switch pulseaudioEvent over
			to VOLUME_UP_PULSEAUDIO_EVENT:{



				struct{
					pa_cvolume /*-*/ volume;
					bool /*-------*/ mute;
				} data;



				pa_cvolume newVolume;
				pa_operation *operation = pa_context_get_sink_info_by_name(context, defaultSinkName, temporaryCallback, &data);
				pa_threaded_mainloop_wait(mainloop);
				pa_operation_unref(operation);



				{
					int percentage = (pa_cvolume_avg(&data.volume) + 1) * 100 / PA_VOLUME_NORM + volumeUpPercent;
					if(percentage > 100){
						percentage = 100;
					}
					newVolume = *pa_cvolume_set(&data.volume, data.volume.channels, PA_VOLUME_NORM * percentage / 100);
				}



				operation = pa_context_set_sink_volume_by_name(context, defaultSinkName, &newVolume, boolStatus, NULL);
				pa_threaded_mainloop_wait(mainloop);
				pa_operation_unref(operation);



				jmp eventLoop;
			}
			to VOLUME_DOWN_PULSEAUDIO_EVENT:{



				struct{
					pa_cvolume /*-*/ volume;
					bool /*-------*/ mute;
				} data;



				pa_cvolume newVolume;



				pa_operation *operation = pa_context_get_sink_info_by_name(context, defaultSinkName, temporaryCallback, &data);



				pa_threaded_mainloop_wait(mainloop);
				pa_operation_unref(operation);



				{
					int percentage = (pa_cvolume_avg(&data.volume) + 1) * 100 / PA_VOLUME_NORM - volumeDownPercent;
					if(percentage < 0){
						percentage = 0;
					}
					newVolume = *pa_cvolume_set(&data.volume, data.volume.channels, PA_VOLUME_NORM * percentage / 100);
				}



				operation = pa_context_set_sink_volume_by_name(context, defaultSinkName, &newVolume, boolStatus, NULL);



				pa_threaded_mainloop_wait(mainloop);
				pa_operation_unref(operation);



				jmp eventLoop;
			}
			to MUTE_PULSEAUDIO_EVENT:{



				struct{
					pa_cvolume /*-*/ volume;
					bool /*-------*/ mute;
				} data;
				pa_operation *operation = pa_context_get_sink_info_by_name(context, defaultSinkName, temporaryCallback, &data);



				pa_threaded_mainloop_wait(mainloop);
				pa_operation_unref(operation);



				operation = pa_context_set_sink_mute_by_name(context, defaultSinkName, !data.mute, boolStatus, NULL);



				/*! uint token = pushPointer(operation, "pulseaudio set sink mute operation", iOperationUnref); */



				pa_threaded_mainloop_wait(mainloop);
				pa_operation_unref(operation);



				/*! popPointer(token); */



				jmp eventLoop;
			}
			off:{
				printTitledValuedError("pulseaudio event loop error", "received unrecognized event with type", pulseaudioEvent);
				jmp eventLoop;
			}
		end
	}
	emergencyExit:{



		pa_context_disconnect(context);
		pa_context_unref(context);



		pa_threaded_mainloop_free(mainloop);



/*!
		popPointer(contextToken);
		popPointer(mainloopToken);
*/



		ret NULL;
	}
	#undef  PA_CONTEXT_NONE
}
GETSTATE(){
	switch pa_context_get_state(context) over
		to PA_CONTEXT_UNCONNECTED: /*--*/ /*--------------------------------------------*/ ret;
		to PA_CONTEXT_CONNECTING: /*---*/ /*--------------------------------------------*/ ret;
		to PA_CONTEXT_AUTHORIZING: /*--*/ /*--------------------------------------------*/ ret;
		to PA_CONTEXT_SETTING_NAME: /*-*/ /*--------------------------------------------*/ ret;
		to PA_CONTEXT_READY: /*--------*/ *(uint *)userdata = PA_CONTEXT_READY; /*------*/ ret;
		to PA_CONTEXT_FAILED: /*-------*/ *(uint *)userdata = PA_CONTEXT_FAILED; /*-----*/ ret;
		to PA_CONTEXT_TERMINATED: /*---*/ *(uint *)userdata = PA_CONTEXT_TERMINATED; /*-*/ ret;
		off: /*------------------------*/ *(uint *)userdata = PA_CONTEXT_FAILED; /*-----*/ ret;
	end
}
SUBSCRIBECALLBACK(){
	(void)context;
	(void)idx;
	(void)userdata;
	if((event & PA_SUBSCRIPTION_EVENT_FACILITY_MASK) != PA_SUBSCRIPTION_EVENT_SINK){
		ret;
	}
	if((event & PA_SUBSCRIPTION_EVENT_TYPE_MASK) == PA_SUBSCRIPTION_EVENT_NEW){
		pa_operation *const operation = pa_context_get_server_info(context, getSinkName, NULL);
/*!
		uint token = pushPointer(operation, "pulseaudio subscription pointer", iOperationUnref);
*/
		pa_operation_unref(operation);
/*!
		popPointer(token);
*/
		ret;
	}
	if((event & PA_SUBSCRIPTION_EVENT_TYPE_MASK) == PA_SUBSCRIPTION_EVENT_REMOVE){
		pa_operation *const operation = pa_context_get_server_info(context, getSinkName, NULL);
/*!
		uint token = pushPointer(operation, "pulseaudio server info pointer", iOperationUnref);
*/
		pa_operation_unref(operation);
/*!
		popPointer(token);
*/
		ret;
	}
	if((event & PA_SUBSCRIPTION_EVENT_TYPE_MASK) == PA_SUBSCRIPTION_EVENT_CHANGE){
		pa_operation *const operation = pa_context_get_sink_info_by_name(context, defaultSinkName, getSinkInfo, NULL);
/*!
		uint token = pushPointer(operation, "pulseaudio sink info pointer", iOperationUnref);
*/
		pa_operation_unref(operation);
/*!
		popPointer(token);
*/
		ret;
	}
	ret;
}
GETSINKNAME(){
	(void)context;
	(void)userdata;
	defaultSinkName = (*serverInfo).default_sink_name;
	ret;
}
FIRSTGETSINKINFOCALLBACK(){
	(void)context;
	(void)userdata;
	if(eol < 0){
		printTitledError("pulseaudio error", "could not get initial sink information");
		ret;
	}
	if(!eol){
		const int newVolume = (pa_cvolume_avg(&(*sinkInfo).volume) + 1) * 100 / PA_VOLUME_NORM;
		mute = (*sinkInfo).mute;
		oldVolume = newVolume;
		volume = newVolume;
		rangedOldVolume = oldVolume;
		rangedVolume = volume;
		if(rangedOldVolume > 100){
			rangedOldVolume = 100;
		}elif(rangedOldVolume < 0){
			rangedOldVolume = 0;
		}
		if(rangedVolume > 100){
			rangedVolume = 100;
		}elif(rangedVolume < 0){
			rangedVolume = 0;
		}
		ret;
	}
	ret;
}
GETSINKINFO(){
	(void)context;
	(void)userdata;
	if(eol < 0){
		printTitledError("pulseaudio error", "could not get sink information");
		ret;
	}
	if(!eol){
		const int newVolume = (pa_cvolume_avg(&(*sinkInfo).volume) + 1) * 100 / PA_VOLUME_NORM;
		const bool newMute = (*sinkInfo).mute;
		if(newVolume != volume or newMute != mute){
			const uint32 valueList = XCB_STACK_MODE_ABOVE;
			mute = newMute;
			oldVolume = volume;
			volume = newVolume;
			rangedOldVolume = oldVolume;
			rangedVolume = volume;
			if(rangedOldVolume > 100){
				rangedOldVolume = 100;
			}elif(rangedOldVolume < 0){
				rangedOldVolume = 0;
			}
			if(rangedVolume > 100){
				rangedVolume = 100;
			}elif(rangedVolume < 0){
				rangedVolume = 0;
			}
			switch whichMonitor over
				to AllWhichMonitor: /*--------------*/ jmp allWhichMonitor;
				to InitialPointerWhichMonitor: /*---*/ jmp initialPointerWhichMonitor;
				to FollowingPointerWhichMonitor: /*-*/ jmp followingPointerWhichMonitor;
				off: /*-----------------------------*/ jmp whichMonitorExit;
			end
			allWhichMonitor:{



				Monitor *monitorCurrent = monitorStart;
				mapAllMonitors0Loop:{
					xcb_configure_window(connection, (*monitorCurrent).window, XCB_CONFIG_WINDOW_STACK_MODE, &valueList);
					xcb_map_window(connection, (*monitorCurrent).window);
					(*monitorCurrent).windowIsMapped = true;
					if(inc monitorCurrent < monitorWall){
						jmp mapAllMonitors0Loop;
					}
				}



				jmp whichMonitorExit;
			}
			initialPointerWhichMonitor:{



				Monitor *monitorCurrent = getPointerMonitor();
				if(!(*monitorCurrent).windowIsMapped){
					Monitor *current = monitorStart;
					mapAllMonitors1Loop:{
						if((*current).windowIsMapped){
							xcb_unmap_window(connection, (*current).window);
							(*current).windowIsMapped = false;
						}
						if(inc current < monitorWall){
							jmp mapAllMonitors1Loop;
						}
					}
				}
				xcb_configure_window(connection, (*monitorCurrent).window, XCB_CONFIG_WINDOW_STACK_MODE, &valueList);
				xcb_map_window(connection, (*monitorCurrent).window);
				(*monitorCurrent).windowIsMapped = true;



				jmp whichMonitorExit;
			}
			followingPointerWhichMonitor:{



				/*!
					following the pointer monitor
				*/



				jmp whichMonitorExit;
			}
			whichMonitorExit:{
				clock_gettime(CLOCK_MONOTONIC_RAW, &t0);
				xcb_flush(connection);
			}
		}
		ret;
	}
	ret;
}
BOOLSTATUS(){
	(void)context;
	(void)success;
	(void)userData;
    pa_threaded_mainloop_signal(mainloop, 0);
	ret;
}
TEMPORARYCALLBACK(){
	(void)context;
	if(eol < 0){
		printTitledError("pulseaudio error", "could not get sink information");
        pa_threaded_mainloop_signal(mainloop, 0);
		ret;
	}
	if(!eol){
		pa_cvolume *data = userData;
		*(pa_cvolume *)userData = (*sinkInfo).volume;
		*(bool *)(data + 1) = (*sinkInfo).mute;
        pa_threaded_mainloop_signal(mainloop, 0);
		ret;
	}
	ret;
}



























SETSTRINGROOT(){
	#define DATA_BLOCK_SIZE /*-*/ (256)
	(*root).dataSize = DATA_BLOCK_SIZE;
	(*root).dataAllocated = 0;
	(*root).data = malloc(DATA_BLOCK_SIZE * sizeof(StringNode));
	(*root).dataToken = 0;
	(*root).counter = 1;
	(*root).letter = 0;
	(*root).childrenAmount = 0;
	if(!(*root).data){
		printTitledError("memory allocation error", "could not allocate memory for a string tree");
		ret;
	}
	(*root).dataToken = pushPointer((*root).data, "string tree pointer", iFree);
	ret;
}
BULKINSERTSTRING(){
	jmp confirmRootValidity;
	confirmRootValidity:{
		if(!(*root).data){
			ret;
		}
		(*root).stringArray = current;
		jmp insertStringLoop;
	}
	insertStringLoop:{
		if(insertString(root, *current) and *(inc current)){
			jmp insertStringLoop;
		}
		jmp trimMemory;
	}
	trimMemory:{
		void *temp;
		(*root).dataSize = (*root).dataAllocated;
		if(!(temp = realloc((*root).data, (*root).dataSize * sizeof(StringNode)))){
			ret;
		}
		updatePointer((*root).dataToken, temp);
		(*root).data = temp;
		ret;
	}
}
INSERTSTRING(){
	StringNode *node;
	uint allocated = (*root).dataAllocated;
	uint size = (*root).dataSize;
	StringNode *data = (*root).data;
	if(string == lastGlobalCommandString){
		lastGlobalCommand = (*root).counter;
	}
	jmp findString;
	findString:{
		if(!(node = getStringNode(root, &string))){
			ret false;
		}
		jmp addLetterLoop;
	}
	addLetterLoop:{
		if(allocated == size){
			const uint nodeOffset = node - data;
			void *temp;
			size += DATA_BLOCK_SIZE;
			if(!(temp = realloc(data, size * sizeof(StringNode)))){
				printTitledError("memory allocation error", "could not reallocate memory for new string tree node");
				(*node).letter = 128 | (*root).counter;
				inc (*root).counter;
				(*root).data = data;
				(*root).dataSize = size - DATA_BLOCK_SIZE;
				(*root).dataAllocated = allocated;
				ret false;
			}
			updatePointer((*root).dataToken, temp);
			data = temp;
			if(node != (void *)&(*root).letter){
				node = data + nodeOffset;
			}
		}
		if((*node).childrenAmount >= STRING_NODE_CHILDREN_AMOUNT){
			printTitledError("insert string error", "out of space for new children in string node");
			ret false;
		}
		*((*node).offset + (*node).childrenAmount) = allocated;
		inc (*node).childrenAmount;
		node = data + allocated;
		(*node).childrenAmount = 0;
		inc allocated;
		if(*string){
			(*node).letter = *string;
			inc string;
			jmp addLetterLoop;
		}
		(*node).letter = 128 | (*root).counter;
		inc (*root).counter;
		(*root).data = data;
		(*root).dataSize = size;
		(*root).dataAllocated = allocated;
		ret true;
	}
}
GETSTRINGNODE(){
	const uint16 *offsetCurrent;
	const uint16 *offsetWall;
	const char *string;
	StringNode *node;
	StringNode *data;
	jmp confirmRootValidity;
	confirmRootValidity:{
		if(!(*root).data){
			ret NULL;
		}
		string = *stringReturn;
		node = (void *)&(*root).letter;
		data = (*root).data;
		jmp findLetterLoop;
	}
	findLetterLoop:{
		offsetCurrent = (*node).offset;
		offsetWall = offsetCurrent + (*node).childrenAmount;
		jmp nextLetterLoop;
	}
	nextLetterLoop:{
		if(offsetCurrent < offsetWall){
			StringNode *c = data + *offsetCurrent;
			char ch = *string;
			ch += (ch >= 'A' and ch <= 'Z') * 32 - (ch == '_') * 50;
			if(!ch and (*c).letter & 128){
				(*root).returnedCounter = ((*c).letter & ~b(10000000)) - 1;
				*stringReturn = string;
				ret NULL;
			}
			if((*c).letter != ch){
				inc offsetCurrent;
				jmp nextLetterLoop;
			}
			node = c;
			inc string;
			jmp findLetterLoop;
		}
		*stringReturn = string;
		ret node;
	}
}
DELETESTRINGROOT(){
	free((*root).data);
	popPointer((*root).dataToken);
	ret;
	#undef  DATA_BLOCK_SIZE
}
SETSHORTCUTROOT(){
	#define MODIFIER_DATA_BLOCK_SIZE /*-*/ (32)
	#define WINDOW_DATA_BLOCK_SIZE /*---*/ (32)
	(*root).modifierSize = MODIFIER_DATA_BLOCK_SIZE;
	(*root).modifierAllocated = 1;
	(*root).modifierData = malloc((*root).modifierSize * sizeof(ModifierNode));
	(*root).modifierToken = 0;
	(*root).windowDataSize = WINDOW_DATA_BLOCK_SIZE;
	(*root).windowDataAllocated = 0;
	(*root).windowData = malloc((*root).windowDataSize * sizeof(WindowShortcut));
	(*root).windowDataToken = 0;
	if(!(*root).modifierData){
		printTitledError("memory allocation error", "could not allocate shortcut modifier memory");
		free((*root).modifierData);
		popPointer((*root).modifierToken);
		free((*root).windowData);
		popPointer((*root).windowDataToken);
		ret;
	}
	(*root).modifierToken = pushPointer((*root).modifierData, "shortcut modifier list pointer", iFree);
	if(!(*root).windowData){
		printTitledError("memory allocation error", "could not allocate window shortcut memory");
		free((*root).modifierData);
		popPointer((*root).modifierToken);
		free((*root).windowData);
		popPointer((*root).windowDataToken);
		ret;
	}
	(*root).windowDataToken = pushPointer((*root).windowData, "window shortcut array pointer", iFree);
	{
		uint16 *codeListStartCurrent = (*root).codeListStart;
		uint16 *codeListWallCurrent = (*root).codeListWall;
		uint16 *const codeListStartWall = codeListStartCurrent + SHORTCUT_CODE_AMOUNT;
		initializeCodeListsLoop:{
			*codeListStartCurrent = 0;
			*codeListWallCurrent = 0;
			if(inc codeListStartCurrent < codeListStartWall){
				jmp initializeCodeListsLoop;
			}
		}
	}
	ret;
}
INSERTSHORTCUT(){
	const uint modifierAllocated = (*root).modifierAllocated;
	ModifierNode *node;
	WindowShortcut *shortcut;
	if(modifierAllocated == (*root).modifierSize){
		void *temp;
		(*root).modifierSize += MODIFIER_DATA_BLOCK_SIZE;
		if(!(temp = realloc((*root).modifierData, (*root).modifierSize * sizeof(ModifierNode)))){
			printTitledError("memory allocation error", "could not reallocate memory for shortcuts");
			ret false;
		}
		updatePointer((*root).modifierToken, temp);
		(*root).modifierData = temp;
	}
	if((*root).windowDataAllocated == (*root).windowDataSize){
		void *temp;
		(*root).windowDataSize += WINDOW_DATA_BLOCK_SIZE;
		if(!(temp = realloc((*root).windowData, (*root).windowDataSize * sizeof(WindowShortcut)))){
			printTitledError("memory reallocation error", "could not reallocate window shortcut memory");
			ret false;
		}
		updatePointer((*root).windowDataToken, temp);
		(*root).windowData = temp;
	}
	node = (*root).modifierData + modifierAllocated;
	(*node).string = string;
	(*node).stringToken = stringToken;
	(*node).nextOffset = 0;
	(*node).modifier = modifier;
	(*node).command = command;
	if(!*((*root).codeListStart + code)){
		*((*root).codeListStart + code) = modifierAllocated;
	}else{
		const uint offset = *((*root).codeListWall + code);
		(*((*root).modifierData + offset)).nextOffset = modifierAllocated - offset;
	}
	*((*root).codeListWall + code) = modifierAllocated;
	inc (*root).modifierAllocated;
	if(command > lastGlobalCommand){
		shortcut = (*root).windowData + (*root).windowDataAllocated;
		(*shortcut).modifier = modifier;
		(*shortcut).code = code;
		inc (*root).windowDataAllocated;
	}
	ret true;
}
REMOVESHORTCUT(){
	bool hasRemovedShortcut = false;
	ModifierNode *node = (*root).modifierData + *((*root).codeListStart + code);
	if(node > (*root).modifierData){
		grayOutModifierLoop:{
			if(modifier == (*node).modifier){
				free((*node).string);
				popPointer((*node).stringToken);
				(*node).string = NULL;
				(*node).stringToken = 0;
				(*node).command = NONE_COMMAND;
				hasRemovedShortcut = true;
			}
			if((*node).nextOffset){
				node += (*node).nextOffset;
				jmp grayOutModifierLoop;
			}
		}
	}
	if(hasRemovedShortcut){
		const WindowShortcut *const wall = (*root).windowData + (*root).windowDataAllocated;
		WindowShortcut *start = (*root).windowData;
		WindowShortcut *current = (*root).windowData;
		pushOutWindowShortcutLoop:{
			if(current < wall){
				if((*current).code == code and (*current).modifier == modifier){
					dec (*root).windowDataAllocated;
				}else{
					*start = *current;
					inc start;
				}
				inc current;
				jmp pushOutWindowShortcutLoop;
			}
		}
	}
	ret hasRemovedShortcut;
}
RESETSHORTCUTROOT(){
	if((*root).modifierAllocated > 1){
		const ModifierNode *current = (*root).modifierData + 1;
		const ModifierNode *const wall = (*root).modifierData + (*root).modifierAllocated;
		freeStringLoop:{
			if(current < wall){
				free((*current).string);
				popPointer((*current).stringToken);
				inc current;
				jmp freeStringLoop;
			}
		}
		(*root).modifierAllocated = 1;
	}
	ret;
}
DELETESHORTCUTROOT(){
	resetShortcutRoot(root);
	free((*root).modifierData);
	popPointer((*root).modifierToken);
	free((*root).windowData);
	popPointer((*root).windowDataToken);
	ret;
	#undef  WINDOW_DATA_BLOCK_SIZE
	#undef  MODIFIER_DATA_BLOCK_SIZE
}
UNGRABSHORTCUTS(){
	if(connection){
		xcb_ungrab_key(connection, (*screen).root, XCB_GRAB_ANY, XCB_MOD_MASK_ANY);
		xcb_ungrab_button(connection, (*screen).root, XCB_BUTTON_INDEX_ANY, XCB_MOD_MASK_ANY);
	/*!
		if(windowAllocated){
			xcb_window_t *windowStart;
			xcb_window_t *windowCurrent;
			xcb_window_t *const windowWall = windowStart + windowAllocated;
			ungrabWindowLoop:{
				xcb_ungrab_key(connection, *windowCurrent, XCB_GRAB_ANY, XCB_MOD_MASK_ANY);
				xcb_ungrab_button(connection, *windowCurrent, XCB_BUTTON_INDEX_ANY, XCB_MOD_MASK_ANY);
				if(inc windowCurrent < windowWall){
					jmp ungrabWindowLoop;
				}
			}
		}
	*/
	}
	ret;
}
READCONFIG(){
	#define STATEMENT_BLOCK_SIZE /*-*/ (256)
	const Instruction *const *currentScopeInstruction = globalScopeInstruction;
	const char *const *currentScopeInstructionList = globalInstructionList;
	const Instruction *instructionStart;
	const Instruction *instructionCurrent;
	const Instruction *name0Instruction;
	const Instruction *name1Instruction;
	const Instruction *name2Instruction;
	const Instruction *name3Instruction;
	const Instruction *name4Instruction;
	const Instruction *nameList0Instruction;
	const Instruction *nameList1Instruction;
	const Instruction *nameList2Instruction;
	const Instruction *nameList3Instruction;
	const Instruction *nameList4Instruction;
	const Instruction *integer0Instruction;
	const Instruction *integer1Instruction;
	const Instruction *integer2Instruction;
	const Instruction *integer3Instruction;
	const Instruction *integer4Instruction;
	const Instruction *string0Instruction;
	const Instruction *string1Instruction;
	const Instruction *string2Instruction;
	const Instruction *string3Instruction;
	const Instruction *string4Instruction;
	const Instruction *execute0Instruction;
	const Instruction *execute1Instruction;
	const Instruction *execute2Instruction;
	const Instruction *execute3Instruction;
	const Instruction *execute4Instruction;
	const Instruction *image0Instruction;
	const Instruction *image1Instruction;
	const Instruction *image2Instruction;
	const Instruction *image3Instruction;
	const Instruction *image4Instruction;
	const char *imageErrorMessage;
	FILE *configFile = NULL;
	uint configFileToken;
	uint statementSize = STATEMENT_BLOCK_SIZE;
	char *statementStart = NULL;
	uint statementStartToken = 0;
	char *statementCurrent;
	char *statementWall = NULL;
	char *statementConcreteWall;
	uint8 name0Return;
	uint8 name1Return;
	uint8 name2Return;
	uint8 name3Return;
	uint8 name4Return;
	uint8 nameList0Return;
	uint8 nameList1Return;
	uint8 nameList2Return;
	uint8 nameList3Return;
	uint8 nameList4Return;
	int integer0Return;
	int integer1Return;
	int integer2Return;
	int integer3Return;
	int integer4Return;
	char *string0Return = NULL;
	uint string0Token = 0;
	char *string1Return = NULL;
	uint string1Token = 0;
	char *string2Return = NULL;
	uint string2Token = 0;
	char *string3Return = NULL;
	uint string3Token = 0;
	char *string4Return = NULL;
	uint string4Token = 0;
	char *execute0Return = NULL;
	uint execute0Token = 0;
	char *execute1Return = NULL;
	uint execute1Token = 0;
	char *execute2Return = NULL;
	uint execute2Token = 0;
	char *execute3Return = NULL;
	uint execute3Token = 0;
	char *execute4Return = NULL;
	uint execute4Token = 0;
	Image image0Return;
	Image image1Return;
	Image image2Return;
	Image image3Return;
	Image image4Return;
	JmpPoint jmpPoint;
	uint fileLine = 1;
	uint statementLine = 0;
	char fileChar;
	uint itemAmount;
	char quote = '\0';
	uint currentScopeInstructionListSize = STRING_ARRAY_SIZE(globalInstructionList);
	StringNodeRoot *const *const *currentScopeInstructionData = globalScopeInstructionData;
	StringNodeRoot *const *instructionCurrentData;
	StringNodeRoot *currentScopeInstructionRoot = &globalInstructionRoot;
	image0Return.data = NULL;
	image0Return.dataToken = 0;
	image1Return.data = NULL;
	image1Return.dataToken = 0;
	image2Return.data = NULL;
	image2Return.dataToken = 0;
	image3Return.data = NULL;
	image3Return.dataToken = 0;
	image4Return.data = NULL;
	image4Return.dataToken = 0;
	jmp setupPointers;
	setupPointers:{
		if(getConfigChar == fgetc){
			if(!createConfigFile){
				DIR *dir;
				if((dir = opendir(configPath))){
					const uint token = pushPointer(dir, "config directory argument", closedir);
					closedir(dir);
					popPointer(token);
					printConfigError("config error", "config file is directory", '\0', false, false, false, false, configPath, 1, statementStart, statementWall, NULL, NULL, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
					jmp configEmergencyExit;
				}
			}
			if(!(configFile = fopen(configPath, "r"))){
				#define BUFFER_SIZE /*-*/ (4096)
				FILE *defaultConfigFile;
				uint defaultConfigFileToken;
				if(!createConfigFile){
					printConfigError("config error", "could not open config file", '\0', false, false, false, false, configPath, 1, statementStart, statementWall, NULL, NULL, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
					jmp configEmergencyExit;
				}
				if(!(configFile = fopen(configPath, "w"))){
					printConfigError("config error", "could not create config file", '\0', false, false, false, false, configPath, 1, statementStart, statementWall, NULL, NULL, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
					jmp configEmergencyExit;
				}
				configFileToken = pushPointer(configFile, "config file", fclose);
				if(!(defaultConfigFile = fopen(DEFAULT_CONFIG_PATH, "r"))){
					remove(configPath);
					printTitledNamedError("config file error", "could not copy default configuration file from", DEFAULT_CONFIG_PATH);
					jmp configEmergencyExit;
				}
				defaultConfigFileToken = pushPointer(defaultConfigFile, "default config file", fclose);
				copyConfigFileLoop:{
					char buffer[BUFFER_SIZE];
					size_t bytesRead;
					if((bytesRead = fread(buffer, sizeof(*buffer), sizeof(buffer), defaultConfigFile))){
						if(fwrite(buffer, sizeof(*buffer), bytesRead, configFile) != bytesRead){
							fclose(defaultConfigFile);
							popPointer(defaultConfigFileToken);
							remove(configPath);
							printTitledError("config copying error", "could not copy default config file correctly");
							jmp configEmergencyExit;
						}
						jmp copyConfigFileLoop;
					}
				}
				fclose(defaultConfigFile);
				popPointer(defaultConfigFileToken);
				fclose(configFile);
				popPointer(configFileToken);
				if(!(configFile = fopen(configPath, "r"))){
					printTitledError("config error", "could not open newly written file");
					jmp configEmergencyExit;
				}
				#undef  BUFFER_SIZE
			}
			configFileToken = pushPointer(configFile, "config file", fclose);
		}
		if(!(statementStart = malloc(statementSize * sizeof(char)))){
			printTitledError("config error", "could not store user data");
			jmp configEmergencyExit;
		}
		statementStartToken = pushPointer(statementStart, "statement pointer", iFree);
		jmp getStatementStart;
	}
	getStatementStart:{
		#define EOF_N1 /*------------------------*/ (EOF)
		#define ZER_00 /*------------------------*/ ('\0')
		#define EOT_04 /*------------------------*/ (0x04)
		#define ALR_07 /*------------------------*/ ('\a')
		#define BSP_08 /*------------------------*/ ('\b')
		#define TAB_09 /*------------------------*/ ('\t')
		#define NLN_10 /*------------------------*/ ('\n')
		#define VTB_11 /*------------------------*/ ('\v')
		#define FFD_12 /*------------------------*/ ('\f')
		#define CRE_13 /*------------------------*/ ('\r')
		#define ESC_27 /*------------------------*/ ('\e')
		#define SPC_32 /*------------------------*/ (' ')
		#define DQT_34 /*------------------------*/ ('\"')
		#define SQT_39 /*------------------------*/ ('\'')
		#define AST_42 /*------------------------*/ ('*')
		#define FSL_47 /*------------------------*/ ('/')
		#define ZER_48 /*------------------------*/ ('0')
		#define SCL_59 /*------------------------*/ (';')
		#define QMK_63 /*------------------------*/ ('?')
		#define BSL_92 /*------------------------*/ ('\\')
		#define LOA_97 /*------------------------*/ ('a')
		#define LOB_98 /*------------------------*/ ('b')
		#define LOF_102 /*-----------------------*/ ('f')
		#define LON_110 /*-----------------------*/ ('n')
		#define LOR_114 /*-----------------------*/ ('r')
		#define LOT_116 /*-----------------------*/ ('t')
		#define LOV_118 /*-----------------------*/ ('v')
		#define OCB_123 /*-----------------------*/ ('{')
		#define BAR_124 /*-----------------------*/ ('|')
		#define CCB_125 /*-----------------------*/ ('}')
		#define GetStatementJmpPoint /*----------*/ (0)
		#define StoreWhitespaceJmpPoint /*-------*/ (1)
		#define CheckCommentJmpPoint /*----------*/ (2)
		#define StoreBarJmpPoint /*--------------*/ (3)
		#define GetDoubleQuotationJmpPoint /*----*/ (4)
		#define GetSingleQuotationJmpPoint /*----*/ (5)
		#define HandleEscapeCharacterJmpPoint /*-*/ (6)
		#define EnterScopeJmpPoint /*------------*/ (7)
		#define GetStatementEndJmpPoint /*-------*/ (8)
		statementCurrent = statementStart;
		statementConcreteWall = statementStart + statementSize * sizeof(char);
		statementLine = 0;
		itemAmount = 0;
		free(string0Return);
		popPointer(string0Token);
		free(string1Return);
		popPointer(string1Token);
		free(string2Return);
		popPointer(string2Token);
		free(string3Return);
		popPointer(string3Token);
		free(string4Return);
		popPointer(string4Token);
		free(execute0Return);
		popPointer(execute0Token);
		free(execute1Return);
		popPointer(execute1Token);
		free(execute2Return);
		popPointer(execute2Token);
		free(execute3Return);
		popPointer(execute3Token);
		free(execute4Return);
		popPointer(execute4Token);
		free(image0Return.data);
		popPointer(image0Return.dataToken);
		free(image1Return.data);
		popPointer(image1Return.dataToken);
		free(image2Return.data);
		popPointer(image2Return.dataToken);
		free(image3Return.data);
		popPointer(image3Return.dataToken);
		free(image4Return.data);
		popPointer(image4Return.dataToken);
		name0Instruction = NULL;
		name1Instruction = NULL;
		name2Instruction = NULL;
		name3Instruction = NULL;
		name4Instruction = NULL;
		nameList0Instruction = NULL;
		nameList1Instruction = NULL;
		nameList2Instruction = NULL;
		nameList3Instruction = NULL;
		nameList4Instruction = NULL;
		integer0Instruction = NULL;
		integer1Instruction = NULL;
		integer2Instruction = NULL;
		integer3Instruction = NULL;
		integer4Instruction = NULL;
		string0Instruction = NULL;
		string1Instruction = NULL;
		string2Instruction = NULL;
		string3Instruction = NULL;
		string4Instruction = NULL;
		execute0Instruction = NULL;
		execute1Instruction = NULL;
		execute2Instruction = NULL;
		execute3Instruction = NULL;
		execute4Instruction = NULL;
		image0Instruction = NULL;
		image1Instruction = NULL;
		image2Instruction = NULL;
		image3Instruction = NULL;
		image4Instruction = NULL;
		string0Return = NULL;
		string0Token = 0;
		string1Return = NULL;
		string1Token = 0;
		string2Return = NULL;
		string2Token = 0;
		string3Return = NULL;
		string3Token = 0;
		string4Return = NULL;
		string4Token = 0;
		execute0Return = NULL;
		execute0Token = 0;
		execute1Return = NULL;
		execute1Token = 0;
		execute2Return = NULL;
		execute2Token = 0;
		execute3Return = NULL;
		execute3Token = 0;
		execute4Return = NULL;
		execute4Token = 0;
		image0Return.data = NULL;
		image0Return.dataToken = 0;
		image1Return.data = NULL;
		image1Return.dataToken = 0;
		image2Return.data = NULL;
		image2Return.dataToken = 0;
		image3Return.data = NULL;
		image3Return.dataToken = 0;
		image4Return.data = NULL;
		image4Return.dataToken = 0;
		jmp getStatement;
	}
	getStatement: switch fileChar = getConfigChar(configFile) over
		to EOF_N1: /*--*/ /*---------*/ jmp endOfFile;
		to EOT_04: /*--*/ /*---------*/ jmp endOfFile;
		to ZER_00: /*--*/ /*---------*/ jmp storeWhitespace;
		to TAB_09: /*--*/ /*---------*/ jmp storeWhitespace;
		to NLN_10: /*--*/ inc fileLine; jmp storeWhitespace;
		to VTB_11: /*--*/ /*---------*/ jmp storeWhitespace;
		to FFD_12: /*--*/ /*---------*/ jmp storeWhitespace;
		to CRE_13: /*--*/ /*---------*/ jmp storeWhitespace;
		to SPC_32: /*--*/ /*---------*/ jmp storeWhitespace;
		to DQT_34: /*--*/ quote = '\"'; jmp getDoubleQuotation;
		to SQT_39: /*--*/ quote = '\''; jmp getSingleQuotation;
		to FSL_47: /*--*/ /*---------*/ jmp checkCommentStoreCharacter;
		to SCL_59: /*--*/ /*---------*/ jmp completeStatement;
		to OCB_123: /*-*/ /*---------*/ jmp handleOpeningBracket;
		to BAR_124: /*-*/ /*---------*/ jmp attemptStoreBar;
		to CCB_125: /*-*/ /*---------*/ jmp handleClosingBracket;
		off: /*--------*/ /*---------*/ jmp getStatementStoreCharacter;
	end
	getDoubleQuotation: switch fileChar = getConfigChar(configFile) over
		to EOF_N1: /*-*/ /*----------------------------------*/ jmp completeStatement;
		to ZER_00: /*-*/ fileChar = ' '; /*------------------*/ jmp getDoubleQuotationStoreCharacter;
		to EOT_04: /*-*/ /*----------------------------------*/ jmp endOfFile;
		to NLN_10: /*-*/ inc fileLine; /*--------------------*/ jmp getDoubleQuotationStoreCharacter;
		to DQT_34: /*-*/ fileChar = '\0'; inc itemAmount; /*-*/ jmp getStatementStoreCharacter;
		to BSL_92: /*-*/ /*----------------------------------*/ jmp handleEscapeCharacterStoreCharacter;
		off: /*-------*/ /*----------------------------------*/ jmp getDoubleQuotationStoreCharacter;
	end
	getSingleQuotation: switch fileChar = getConfigChar(configFile) over
		to EOF_N1: /*-*/ /*----------------------------------*/ jmp completeStatement;
		to ZER_00: /*-*/ fileChar = ' '; /*------------------*/ jmp getSingleQuotationStoreCharacter;
		to EOT_04: /*-*/ /*----------------------------------*/ jmp endOfFile;
		to NLN_10: /*-*/ inc fileLine; /*--------------------*/ jmp getSingleQuotationStoreCharacter;
		to SQT_39: /*-*/ fileChar = '\0'; inc itemAmount; /*-*/ jmp getStatementStoreCharacter;
		to BSL_92: /*-*/ /*----------------------------------*/ jmp handleEscapeCharacterStoreCharacter;
		off: /*-------*/ /*----------------------------------*/ jmp getSingleQuotationStoreCharacter;
	end
	handleEscapeCharacter: switch fileChar = getConfigChar(configFile) over
		to DQT_34: /*--*/ fileChar = '\"'; jmp storeEscapedCharacter;
		to SQT_39: /*--*/ fileChar = '\''; jmp storeEscapedCharacter;
		to ZER_48: /*--*/ fileChar = '\0'; jmp storeEscapedCharacter;
		to QMK_63: /*--*/ fileChar = '\?'; jmp storeEscapedCharacter;
		to BSL_92: /*--*/ fileChar = '\\'; jmp storeEscapedCharacter;
		to LOA_97: /*--*/ fileChar = '\a'; jmp storeEscapedCharacter;
		to LOB_98: /*--*/ fileChar = '\b'; jmp storeEscapedCharacter;
		to LOF_102: /*-*/ fileChar = '\f'; jmp storeEscapedCharacter;
		to LON_110: /*-*/ fileChar = '\n'; jmp storeEscapedCharacter;
		to LOR_114: /*-*/ fileChar = '\r'; jmp storeEscapedCharacter;
		to LOT_116: /*-*/ fileChar = '\t'; jmp storeEscapedCharacter;
		to LOV_118: /*-*/ fileChar = '\v'; jmp storeEscapedCharacter;
		off: /*--------*/ /*------------*/ jmp getStatementStoreCharacter;
	end
	checkComment: switch fileChar = getConfigChar(configFile) over
		to EOF_N1: /*--*/ /*-----------------------*/ jmp endOfFile;
		to EOT_04: /*--*/ /*-----------------------*/ jmp endOfFile;
		to ZER_00: /*--*/ /*-----------------------*/ jmp storeWhitespace;
		to TAB_09: /*--*/ /*-----------------------*/ jmp storeWhitespace;
		to NLN_10: /*--*/ inc fileLine; /*---------*/ jmp storeWhitespace;
		to VTB_11: /*--*/ /*-----------------------*/ jmp storeWhitespace;
		to FFD_12: /*--*/ /*-----------------------*/ jmp storeWhitespace;
		to CRE_13: /*--*/ /*-----------------------*/ jmp storeWhitespace;
		to SPC_32: /*--*/ /*-----------------------*/ jmp storeWhitespace;
		to DQT_34: /*--*/ quote = '\"'; /*---------*/ jmp getDoubleQuotation;
		to SQT_39: /*--*/ quote = '\''; /*---------*/ jmp getSingleQuotation;
		to AST_42: /*--*/ dec statementCurrent; /*-*/ jmp ignoreMultipleLineComment;
		to FSL_47: /*--*/ dec statementCurrent; /*-*/ jmp ignoreSingleLineComment;
		to SCL_59: /*--*/ /*-----------------------*/ jmp completeStatement;
		to OCB_123: /*-*/ /*-----------------------*/ jmp handleOpeningBracket;
		to BAR_124: /*-*/ /*-----------------------*/ jmp attemptStoreBar;
		to CCB_125: /*-*/ /*-----------------------*/ jmp handleClosingBracket;
		off: /*--------*/ /*-----------------------*/ jmp getStatementStoreCharacter;
	end
	ignoreMultipleLineComment: switch fileChar = getConfigChar(configFile) over
		to EOF_N1: /*-*/ /*---------*/ jmp endOfFile;
		to EOT_04: /*-*/ /*---------*/ jmp endOfFile;
		to NLN_10: /*-*/ inc fileLine; jmp ignoreMultipleLineComment;
		to AST_42: /*-*/ /*---------*/ jmp checkMultipleLineCommentEnd;
		off: /*-------*/ /*---------*/ jmp ignoreMultipleLineComment;
	end
	checkMultipleLineCommentEnd: switch fileChar = getConfigChar(configFile) over
		to EOF_N1: /*-*/ /*---------*/ jmp endOfFile;
		to EOT_04: /*-*/ /*---------*/ jmp endOfFile;
		to NLN_10: /*-*/ inc fileLine; jmp ignoreMultipleLineComment;
		to FSL_47: /*-*/ /*---------*/ jmp storeWhitespace;
		off: /*-------*/ /*---------*/ jmp ignoreMultipleLineComment;
	end
	ignoreSingleLineComment: switch fileChar = getConfigChar(configFile) over
		to EOF_N1: /*-*/ /*---------*/ jmp endOfFile;
		to EOT_04: /*-*/ /*---------*/ jmp endOfFile;
		to NLN_10: /*-*/ inc fileLine; jmp storeWhitespace;
		off: /*-------*/ /*---------*/ jmp ignoreSingleLineComment;
	end
	endOfFile:{
		if(statementCurrent == statementStart){
			jmp successfulConfig;
		}
		dec sharedCurrent;
		jmp completeStatement;
	}
	storeWhitespace:{
		if(statementCurrent <= statementStart or !*(statementCurrent - 1)){
			jmp getStatement;
		}
		inc itemAmount;
		fileChar = '\0';
		jmp getStatementStoreCharacter;
	}
	completeStatement:{
		if(statementCurrent <= statementStart){
			jmp getStatement;
		}
		if(!*(statementCurrent - 1)){
			jmp getStatementEnd;
		}
		inc itemAmount;
		fileChar = '\0';
		setJmpPoint(GetStatementEnd);
		jmp storeCharacter;
	}
	handleOpeningBracket:{
		if(statementCurrent <= statementStart){
			*statementCurrent = '\0';
			statementLine = fileLine;
			statementWall = statementCurrent;
			printConfigError("stray opening bracket error", "could not enter nameless scope", '{', true, true, true, false, configPath, statementLine, statementStart, statementWall, NULL, NULL, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp getStatementStart;
		}
		if(*(statementCurrent - 1)){
			inc itemAmount;
			fileChar = '\0';
			setJmpPoint(EnterScope);
			jmp storeCharacter;
		}
		jmp enterScope;
	}
	enterScope:{
		StringNodeRoot *root;
		statementWall = statementCurrent - 1;
		statementCurrent = statementStart;
		if(currentScopeInstruction == globalScopeInstruction){
			root = &globalScopesInstructionRoot;
		}else{
			printConfigError("invalid scope error", "no scopes inside current scope", '{', true, true, true, false, configPath, statementLine, statementStart, statementWall, NULL, NULL, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp getStatementStart;
		}
		if(!findString(root, &statementCurrent)){
			printConfigError("invalid scope error", "invalid scope name", '{', true, true, true, false, configPath, statementLine, statementStart, statementWall, NULL, NULL, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp getStatementStart;
		}
		if(itemAmount > 1){
			printConfigError("scope argument error", "too many arguments", '{', true, true, true, false, configPath, statementLine, statementStart, statementWall, (void *)1, (void *)1, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp getStatementStart;
		}
		currentScopeInstruction = scope1ScopeInstruction;
		currentScopeInstructionData = scope1ScopeInstructionData;
		currentScopeInstructionList = scope1ScopeInstructionList;
		currentScopeInstructionRoot = &scope1ScopeInstructionRoot;
		currentScopeInstructionListSize = STRING_ARRAY_SIZE(scope1ScopeInstructionList);
		jmp getStatementStart;
	}
	attemptStoreBar:{
		if(statementCurrent <= statementStart or !*(statementCurrent - 1)){
			jmp storeBar;
		}
		inc itemAmount;
		fileChar = '\0';
		setJmpPoint(StoreBar);
		jmp storeCharacter;
	}
	storeBar:{
		fileChar = '|';
		setJmpPoint(StoreWhitespace);
		jmp storeCharacter;
	}
	handleClosingBracket:{
		if(statementCurrent > statementStart){
			if(processingSignal){
				dec sharedCurrent;
				jmp completeStatement;
			}
			fseek(configFile, -1, SEEK_CUR);
			jmp completeStatement;
		}
		if(currentScopeInstruction == globalScopeInstruction){
			*statementCurrent = '\0';
			statementLine = fileLine;
			statementWall = statementCurrent;
			printConfigError("stray closing bracket error", "could not drop to previous config scope", '}', true, true, true, false, configPath, statementLine, statementStart, statementWall, NULL, NULL, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp getStatementStart;
		}
		if(currentScopeInstruction == scope1ScopeInstruction){
			currentScopeInstruction = globalScopeInstruction;
			currentScopeInstructionData = globalScopeInstructionData;
			currentScopeInstructionList = globalInstructionList;
			currentScopeInstructionRoot = &globalInstructionRoot;
			currentScopeInstructionListSize = STRING_ARRAY_SIZE(globalInstructionList);
		}
		jmp getStatementStart;
	}
	storeEscapedCharacter:{
		*(statementCurrent - 1) = fileChar;
		if(quote == '\"'){
			jmp getDoubleQuotation;
		}
		jmp getSingleQuotation;
	}
	getStatementStoreCharacter:{
		setJmpPoint(GetStatement);
		jmp storeCharacter;
	}
	getDoubleQuotationStoreCharacter:{
		setJmpPoint(GetDoubleQuotation);
		jmp storeCharacter;
	}
	getSingleQuotationStoreCharacter:{
		setJmpPoint(GetSingleQuotation);
		jmp storeCharacter;
	}
	handleEscapeCharacterStoreCharacter:{
		setJmpPoint(HandleEscapeCharacter);
		jmp storeCharacter;
	}
	checkCommentStoreCharacter:{
		setJmpPoint(CheckComment);
		jmp storeCharacter;
	}
	storeCharacter:{
		if(statementCurrent >= statementConcreteWall){
			const uint offset = statementCurrent - statementStart;
			void *temp;
			statementSize += STATEMENT_BLOCK_SIZE;
			if(!(temp = realloc(statementStart, statementSize * sizeof(char)))){
				printConfigError("memory allocation error", "could not reallocate more memory for a longer config statement", ';', true, false, false, false, configPath, statementLine, statementStart, statementWall, NULL, NULL, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
				jmp getStatementStart;
			}
			updatePointer(statementStartToken, temp);
			statementStart = temp;
			statementCurrent = statementStart + offset;
			statementConcreteWall = statementStart + statementSize * sizeof(char);
		}
		if(!statementLine){
			statementLine = fileLine;
		}
		*statementCurrent = fileChar;
		inc statementCurrent;
		switch jmpPoint over
			to GetStatementJmpPoint: /*----------*/ jmp getStatement;
			to StoreWhitespaceJmpPoint: /*-------*/ jmp storeWhitespace;
			to CheckCommentJmpPoint: /*----------*/ jmp checkComment;
			to StoreBarJmpPoint: /*--------------*/ jmp storeBar;
			to GetDoubleQuotationJmpPoint: /*----*/ jmp getDoubleQuotation;
			to GetSingleQuotationJmpPoint: /*----*/ jmp getSingleQuotation;
			to HandleEscapeCharacterJmpPoint: /*-*/ jmp handleEscapeCharacter;
			to EnterScopeJmpPoint: /*------------*/ jmp enterScope;
			off: /*------------------------------*/ jmp getStatementEnd;
		end
	}
	getStatementEnd:{
		if(statementCurrent > statementStart) /*-*/ jmp findStatement;
		if(!feof(configFile)) /*-----------------*/ jmp getStatementStart;
		/*---------------------------------------*/ jmp successfulConfig;
		#undef  GetStatementEndJmpPoint
		#undef  EnterScopeJmpPoint
		#undef  HandleEscapeCharacterJmpPoint
		#undef  GetSingleQuotationJmpPoint
		#undef  GetDoubleQuotationJmpPoint
		#undef  StoreBarJmpPoint
		#undef  CheckCommentJmpPoint
		#undef  StoreWhitespaceJmpPoint
		#undef  GetStatementJmpPoint
		#undef  CCB_125
		#undef  BAR_124
		#undef  OCB_123
		#undef  LOV_118
		#undef  LOT_116
		#undef  LOR_114
		#undef  LON_110
		#undef  LOF_102
		#undef  LOB_98
		#undef  LOA_97
		#undef  BSL_92
		#undef  QMK_63
		#undef  SCL_59
		#undef  ZER_48
		#undef  FSL_47
		#undef  AST_42
		#undef  SQT_39
		#undef  DQT_34
		#undef  SPC_32
		#undef  ESC_27
		#undef  CRE_13
		#undef  FFD_12
		#undef  VTB_11
		#undef  NLN_10
		#undef  TAB_09
		#undef  BSP_08
		#undef  ALR_07
		#undef  EOT_04
		#undef  ZER_00
		#undef  EOF_N1
	}
	findStatement:{
		statementWall = statementCurrent - 1;
		statementCurrent = statementStart;
		if(!findString(currentScopeInstructionRoot, &statementCurrent)){
			printConfigError("config error", "unrecognized instruction", ';', true, true, true, true, configPath, statementLine, statementStart, statementWall, NULL, NULL, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp printAllInstructionPatterns;
		}
		instructionStart = *(currentScopeInstruction + (*currentScopeInstructionRoot).returnedCounter);
		instructionCurrent = instructionStart;
		if(*instructionCurrent == NONE_INSTRUCTION){
			jmp unimplementedInstruction;
		}
		if(statementCurrent >= statementWall and *instructionCurrent != END_INSTRUCTION){
			printConfigError("config error", "missing instruction body", ';', true, true, true, true, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp getStatementStart;
		}
		inc statementCurrent;
		instructionCurrentData = *(currentScopeInstructionData + (*currentScopeInstructionRoot).returnedCounter);
		jmp switchInstructionLoop;
	}
	switchInstructionLoop: switch *instructionCurrent over
		to NONE_INSTRUCTION: /*------*/ jmp unimplementedInstruction;
		to NAME_INSTRUCTION: /*------*/ jmp matchName;
		to NAME_LIST_INSTRUCTION: /*-*/ jmp matchNameList;
		to NUMBER_INSTRUCTION: /*----*/ jmp matchInteger;
		to STRING_INSTRUCTION: /*----*/ jmp matchString;
		to EXECUTE_INSTRUCTION: /*---*/ jmp matchExecuteString;
		to IMAGE_INSTRUCTION: /*-----*/ jmp matchImageString;
		off: /*----------------------*/ jmp endOfInstruction;
	end
	unimplementedInstruction:{
		printConfigError("implementation error", "using unimplemented instruction", ';', true, true, true, false, configPath, statementLine, statementStart, statementWall, NULL, NULL, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
		jmp getStatementStart;
	}
	matchName:{
		char *s;
		uint8 *namePointer;
		if(statementCurrent >= statementWall){
			jmp printMissingArgumentError;
		}
		if(!name0Instruction){
			namePointer = &name0Return;
			name0Instruction = instructionCurrent;
		}elif(!name1Instruction){
			namePointer = &name1Return;
			name1Instruction = instructionCurrent;
		}elif(!name2Instruction){
			namePointer = &name2Return;
			name2Instruction = instructionCurrent;
		}elif(!name3Instruction){
			namePointer = &name3Return;
			name3Instruction = instructionCurrent;
		}else{
			namePointer = &name4Return;
			name4Instruction = instructionCurrent;
		}
		s = statementCurrent;
		if(!findString(*instructionCurrentData, &s)){
			printConfigError("match string error", "invalid name", ';', true, true, true, true, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp getStatementStart;
		}
		statementCurrent = s;
		inc statementCurrent;
		*namePointer = (**instructionCurrentData).returnedCounter + 1;
		jmp advanceDataInstruction;
	}
	matchNameList:{
		uint8 *nameListPointer;
		if(statementCurrent >= statementWall){
			jmp printMissingArgumentError;
		}
		if(!nameList0Instruction){
			nameListPointer = &nameList0Return;
			nameList0Instruction = instructionCurrent;
		}elif(!nameList1Instruction){
			nameListPointer = &nameList1Return;
			nameList1Instruction = instructionCurrent;
		}elif(!nameList2Instruction){
			nameListPointer = &nameList2Return;
			nameList2Instruction = instructionCurrent;
		}elif(!nameList3Instruction){
			nameListPointer = &nameList3Return;
			nameList3Instruction = instructionCurrent;
		}else{
			nameListPointer = &nameList4Return;
			nameList4Instruction = instructionCurrent;
		}
		switch matchNameList(*instructionCurrentData, statementWall, &statementCurrent, nameListPointer) over
			to INVALID_NAME_NAME_LIST: /*--*/ jmp invalidNameNameList;
			to PREMATURE_END_NAME_LIST: /*-*/ jmp prematureEndNameList;
			off: /*------------------------*/ jmp advanceDataInstruction;
		end
	}
	invalidNameNameList:{
		printConfigError("bar list error", "invalid name", ';', true, true, true, true, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
		jmp getStatementStart;
	}
	prematureEndNameList:{
		printConfigError("bar list error", "missing final name", ';', true, true, true, true, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
		jmp getStatementStart;
	}
	matchInteger:{
		int *integerPointer;
		if(statementCurrent >= statementWall){
			jmp printMissingArgumentError;
		}
		if(!integer0Instruction){
			integerPointer = &integer0Return;
			integer0Instruction = instructionCurrent;
		}elif(!integer1Instruction){
			integerPointer = &integer1Return;
			integer1Instruction = instructionCurrent;
		}elif(!integer2Instruction){
			integerPointer = &integer2Return;
			integer2Instruction = instructionCurrent;
		}elif(!integer3Instruction){
			integerPointer = &integer3Return;
			integer3Instruction = instructionCurrent;
		}else{
			integerPointer = &integer4Return;
			integer4Instruction = instructionCurrent;
		}
		switch matchInteger(&statementCurrent, statementWall, integerPointer) over
			to NON_NUMBER: /*-------------*/ jmp printNonNumberError;
			to OVERFLOWN_NUMBER: /*-------*/ jmp printOverflownNumberError;
			to DIVIDED_BY_ZERO_NUMBER: /*-*/ jmp printDividedByZeroNumberError;
			off: /*-----------------------*/ jmp advanceInstruction;
		end
	}
	printNonNumberError:{
		printConfigError("match integer error", "not a number", ';', true, true, true, true, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
		jmp getStatementStart;
	}
	printOverflownNumberError:{
		printConfigError("match integer error", "integer overflow", ';', true, true, true, true, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
		jmp getStatementStart;
	}
	printDividedByZeroNumberError:{
		printConfigError("match integer error", "integer divided by zero", ';', true, true, true, true, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
		jmp getStatementStart;
	}
	matchString:{
		char **stringPointer;
		uint *stringTokenPointer;
		if(statementCurrent >= statementWall){
			jmp printMissingArgumentError;
		}
		if(!string0Instruction){
			stringPointer = &string0Return;
			stringTokenPointer = &string0Token;
			string0Instruction = instructionCurrent;
		}elif(!string1Instruction){
			stringPointer = &string1Return;
			stringTokenPointer = &string1Token;
			string1Instruction = instructionCurrent;
		}elif(!string2Instruction){
			stringPointer = &string2Return;
			stringTokenPointer = &string2Token;
			string2Instruction = instructionCurrent;
		}elif(!string3Instruction){
			stringPointer = &string3Return;
			stringTokenPointer = &string3Token;
			string3Instruction = instructionCurrent;
		}else{
			stringPointer = &string4Return;
			stringTokenPointer = &string4Token;
			string4Instruction = instructionCurrent;
		}
		if(!matchString(&statementCurrent, stringPointer, stringTokenPointer)){
			printConfigError("match string error", "could not allocate string data", ';', true, true, false, false, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp getStatementStart;
		}
		jmp advanceInstruction;
	}
	matchExecuteString:{
		char **executePointer;
		uint *executeTokenPointer;
		if(statementCurrent >= statementWall){
			jmp printMissingArgumentError;
		}
		if(!execute0Instruction){
			executePointer = &execute0Return;
			executeTokenPointer = &execute0Token;
			execute0Instruction = instructionCurrent;
		}elif(!execute1Instruction){
			executePointer = &execute1Return;
			executeTokenPointer = &execute1Token;
			execute1Instruction = instructionCurrent;
		}elif(!execute2Instruction){
			executePointer = &execute2Return;
			executeTokenPointer = &execute2Token;
			execute2Instruction = instructionCurrent;
		}elif(!execute3Instruction){
			executePointer = &execute3Return;
			executeTokenPointer = &execute3Token;
			execute3Instruction = instructionCurrent;
		}else{
			executePointer = &execute4Return;
			executeTokenPointer = &execute4Token;
			execute4Instruction = instructionCurrent;
		}
		if(!matchExecute(&statementCurrent, executePointer, executeTokenPointer)){
			printConfigError("match execute error", "could not allocate execute string data", ';', true, true, false, false, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp getStatementStart;
		}
		jmp advanceInstruction;
	}
	matchImageString:{
		char *string = NULL;
		uint token = 0;
		Image *imagePointer;
		uint8 readImageReturn;
		if(statementCurrent >= statementWall){
			jmp printMissingArgumentError;
		}
		if(!image0Instruction){
			imagePointer = &image0Return;
			image0Instruction = instructionCurrent;
		}elif(!image1Instruction){
			imagePointer = &image1Return;
			image1Instruction = instructionCurrent;
		}elif(!image2Instruction){
			imagePointer = &image2Return;
			image2Instruction = instructionCurrent;
		}elif(!image3Instruction){
			imagePointer = &image3Return;
			image3Instruction = instructionCurrent;
		}else{
			imagePointer = &image4Return;
			image4Instruction = instructionCurrent;
		}
		if(!matchString(&statementCurrent, &string, &token)){
			printConfigError("match image error", "could not allocate image string data", ';', true, true, false, false, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
			jmp getStatementStart;
		}
		readImageReturn = readImage(string, &imageErrorMessage, &image0Return);
		free(string); popPointer(token);
		switch readImageReturn over
			to CANNOT_OPEN_READ_CONFIG: /*--------*/ jmp printCannotOpenReadConfig;
			to CANNOT_READ_READ_CONFIG: /*--------*/ jmp printCannotReadReadConfig;
			to UNSUPPORTED_FORMAT_READ_CONFIG: /*-*/ jmp printUnsupportedFormatReadConfig;
			to BAD_HEADER_READ_CONFIG: /*---------*/ jmp printBadHeaderReadConfig;
			to BAD_DEPTH_READ_CONFIG: /*----------*/ jmp printBadDepthReadConfig;
			to BAD_COMPRESSION_READ_CONFIG: /*----*/ jmp printBadCompressionReadConfig;
			to UNSUPPORTED_HEIGHT_READ_CONFIG: /*-*/ jmp printUnsupportedHeightReadConfig;
			to BAD_SIZE_READ_CONFIG: /*-----------*/ jmp printBadSizeReadConfig;
			to FAILED_READ_CONFIG: /*-------------*/ jmp printFailedReadConfig;
			to BAD_PIXELS_READ_CONFIG: /*---------*/ jmp printBadPixelsReadConfig;
			to BAD_IMAGE_READ_CONFIG: /*----------*/ jmp printBadImageReadConfig;
			off: /*-------------------------------*/ jmp advanceInstruction;
		end
	}
	printCannotOpenReadConfig:{
		printConfigError("match image error", "could not open image file", ';', true, true, false, false, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
		jmp getStatementStart;
	}
