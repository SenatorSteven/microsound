			jmp printMissingArgumentError;
		}
		if(statementCurrent < statementWall){
			printConfigError("config error", "extra parameters error", ';', true, true, true, false, configPath, statementLine, statementStart, statementWall, instructionStart, instructionCurrent, currentScopeInstructionList, currentScopeInstructionRoot, currentScopeInstructionData);
