#define LOADTEXTURE_DEC /*---*/ local Texture loadTexture(const char *const path)

#define LITERAL_LENGTH(l) /*-*/ (sizeof(l) - 1)

time_t seconds;

LOADTEXTURE_DEC{
	Texture texture;
	FILE *file;
	uint offset;
	uint8 data[26];
	if(!(file = fopen(path, "rb"))){
		printError("could not open texture file");
		jmp retFailure;
	}
	if(fread(data, 1, 26, file) != 26){
		printError("could not read texture file data");
		jmp retFailure;
	}
	if(*data != 'B' or *(data + 1) != 'M'){
		printError("texture file is not bitmap");
		jmp retFailure;
	}
	offset         = *(uint32 *)(data + 10);
	texture.width  = *(uint32 *)(data + 18);
	texture.height = *(uint32 *)(data + 22);
	texture.size   = *(uint32 *)(data +  2) - offset;
	fseek(file, offset, SEEK_SET);
	if(!(texture.data = malloc(texture.size * sizeof(uint8)))){
		printError("texture file is not bitmap");
		jmp retFailure;
	}
	{
		const uint width = texture.width * 4;
		uint8 *start = texture.data;
		uint8 *current = start + texture.size - width;
		readRowLoop:{
			if(fread(current, 1, width, file) != width){
				printError("could not read texture file data");
				jmp retFailure;
			}
			if((current -= width) >= start){
				jmp readRowLoop;
			}
		}
	}
	fclose(file);
	file = NULL;
	ret texture;
	retFailure:{
		texture.width  = 0;
		texture.height = 0;
		texture.size   = 0;
		texture.data   = NULL;
		ret texture;
	}
}
void realApplyTexture(Texture source, Texture destination){
	bool replace = true;
	int x = 0;
	while(x < source.width){
		int y = 0;
		while(y < source.height){
			if(*(uint32 *)source.data){
				if(replace){
					*(uint32 *)destination.data = *(uint32 *)source.data;
				}else{
					*(uint32 *)destination.data = 0x00000000;
				}
			}
			destination.data = (uint32 *)destination.data + 1;
			source     .data = (uint32 *)source     .data + 1;
			inc y;
		}
		inc x;
	}
	ret;
}
void realApplyTexture1(Texture source, Texture destination){
	int x = 0;
	while(x < source.width){
		int y = 0;
		while(y < source.height){
			if(*(uint32 *)source.data){
				*(uint32 *)destination.data = *(uint32 *)source.data;
			}
			destination.data = (uint32 *)destination.data + 1;
			source     .data = (uint32 *)source     .data + 1;
			inc y;
		}
		inc x;
	}
	ret;
}
void realApplyTexture1WithXY(int sourceX, int sourceY, int destinationX, int destinationY, Texture source, Texture destination){
	uint32 *sourceData = (uint32 *)source.data;
	uint32 *destinationData = (uint32 *)destination.data;
	while(sourceX < source.width){
		int sy = sourceY;
		int dy = destinationY;
		while(sy < source.height){
			if(*(sourceData + sy * source.width + sourceX)){
				*(destinationData + dy * destination.width + destinationX) = *(sourceData + sy * source.width + sourceX);
			}
			inc dy;
			inc sy;
		}
		inc sourceX;
		inc destinationX;
	}
	ret;
}
void filterTexture(Texture filter, Texture destination){
	int x = 0;
	while(x < filter.width){
		int y = 0;
		while(y < filter.height){
			if(!*(uint32 *)filter.data){
				*(uint32 *)destination.data = 0x00000000;
			}
			destination.data = (uint32 *)destination.data + 1;
			filter     .data = (uint32 *)filter     .data + 1;
			inc y;
		}
		inc x;
	}
	ret;
}









#define BOX_SIZE /*------------*/ (111)

#define BACKING_BUFFER_SIZE /*-*/ (1000)

uint32 *kernelColumnRStart;
uint32 *kernelColumnGStart;
uint32 *kernelColumnBStart;

uint32 *pixelRStart;
uint32 *pixelGStart;
uint32 *pixelBStart;

void doubleBoxBlur(const int width, const int height, uint32 *originalData, uint32 *intermediateData, uint32 *destinationData, const int boxSize);

uint32 *intermediateData;
uint32 *data;

Texture case0;
Texture case1;
Texture case2;
Texture case3;
Texture barOverlay;
Texture wallpaper;

int main(const int argumentAmount, const char *const *argument){
	(void)argumentAmount;
	pthread_create(&pulseaudioThread, NULL, pulseaudioStart, NULL);
	jmp main;
	main:{
		duration = 3;
		foreground = 0xFF292929;
		background = 0xFFE5E5E3;
		case0      = loadTexture("/home/steven/Documents/microsound/assets/bars_unfilled.bmp");
		case1      = loadTexture("/home/steven/Documents/microsound/assets/bars_unfilled.bmp");
		case2      = loadTexture("/home/steven/Documents/microsound/assets/bars_unfilled.bmp");
		case3      = loadTexture("/home/steven/Documents/microsound/assets/bars_unfilled.bmp");
		barOverlay = loadTexture("/home/steven/Documents/microsound/assets/bars_filled.bmp");
		wallpaper  = loadTexture("/home/steven/Documents/microsound/assets/wallpaper.bmp");
		{
			Texture soundBox = loadTexture("/home/steven/Documents/microsound/assets/sound_box.bmp");
			realApplyTexture(soundBox, case0);
			realApplyTexture(soundBox, case1);
			realApplyTexture(soundBox, case2);
			realApplyTexture(soundBox, case3);
			free(soundBox.data);
		}
		{
			Texture mute = loadTexture("/home/steven/Documents/microsound/assets/mute.bmp");
			realApplyTexture(mute, case0);
			free(mute.data);
		}
		/*! {
			Texture sound = loadTexture("/home/steven/Documents/microsound/assets/sound.bmp");
			realApplyTexture(sound, case1);
			free(sound.data);
		} */
		{
			Texture plus = loadTexture("/home/steven/Documents/microsound/assets/plus.bmp");
			realApplyTexture(plus, case2);
			free(plus.data);
		}
		{
			Texture minus = loadTexture("/home/steven/Documents/microsound/assets/minus.bmp");
			realApplyTexture(minus, case3);
			free(minus.data);
		}
		width  = case0.width;
		height = case0.height;
		x      = (1920 - width ) / 2;
		y      = (1080 - height) / 2 + height;
		intermediateData = malloc(width * height * sizeof(uint32));
		data             = malloc(width * height * sizeof(uint32));

		kernelColumnRStart = malloc(BOX_SIZE + 2 * width * sizeof(uint32));
		kernelColumnGStart = malloc(BOX_SIZE + 2 * width * sizeof(uint32));
		kernelColumnBStart = malloc(BOX_SIZE + 2 * width * sizeof(uint32));

		pixelRStart = malloc(BOX_SIZE + 2 * width * height * sizeof(uint32));
		pixelGStart = malloc(BOX_SIZE + 2 * width * height * sizeof(uint32));
		pixelBStart = malloc(BOX_SIZE + 2 * width * height * sizeof(uint32));

		jmp setPrimaryGlobals;
	}
	setPrimaryGlobals:{
		programName /*---------*/ = *argument;
		errorPath /*-----------*/ = NULL;
		connectionName /*------*/ = NULL;
		mustOpenErrorStream /*-*/ = false;
		errorStream /*---------*/ = DefaultErrorStream;
		connection /*----------*/ = NULL;
		genericError /*--------*/ = NULL;
		event /*---------------*/ = NULL;
		agp0 /*----------------*/ = NULL;
		quitMessage /*---------*/ = NULL;
		jmp establishServerConnection;
	}
	establishServerConnection:{
		#define ESTABLISHSERVERCONNECTION_CONNECTION /*-----*/ connection
		#define ESTABLISHSERVERCONNECTION_CONNECTIONNAME /*-*/ connectionName
		#define ESTABLISHSERVERCONNECTION_SCREEN /*---------*/ screen
		#include "xcb/establishServerConnection.hold"
		switch xcb_connection_has_error(connection) over
			to XCB_NONE: /*------------*/ /*-----------------------------------------------------------------*/ jmp generateIDs;
			to XCB_CONN_CLOSED_PARSE_ERR: printError(connectionName? "invalid server name" : "no server name"); jmp mainEmergencyExit;
			off: /*--------------------*/ printConnectionError(); /*-----------------------------------------*/ jmp mainEmergencyExit;
		end
	}
	generateIDs:{
		font /*-----*/ = xcb_generate_id(connection);
		gc /*-------*/ = xcb_generate_id(connection);
		window /*---*/ = xcb_generate_id(connection);
		colormap /*-*/ = xcb_generate_id(connection);
		jmp setupScreenProfile;
	}
	setupScreenProfile:{
		#define SETUPSCREENPROFILE_VISUAL /*-*/ visual
		#define SETUPSCREENPROFILE_DEPTH /*--*/ depth
		#include "xcb/setupScreenProfile.hold"
		jmp createWindow;
	}
	createWindow:{
		struct{
			uint32 /*---------*/ backgroundColor;
			uint32 /*---------*/ borderColor;
			bool /*-----------*/ overrideRedirect;
			uint32 /*---------*/ eventMask;
			xcb_colormap_t /*-*/ colormap;
		} attribute;
		requestCheck(xcb_create_colormap_checked(connection, XCB_COLORMAP_ALLOC_NONE, colormap, (*screen).root, visual), "could not create colormap", XCB_NONE);
		attribute.backgroundColor /*--*/ = 0x00000000;
		attribute.borderColor /*------*/ = 0x00000000;
		attribute.overrideRedirect /*-*/ = true;
		attribute.eventMask /*--------*/ = XCB_EVENT_MASK_EXPOSURE;
		attribute.colormap /*---------*/ = colormap;
		requestCheck(xcb_create_window_checked(connection, depth, window, (*screen).root, x, y, width, height, 0, XCB_WINDOW_CLASS_INPUT_OUTPUT, visual, XCB_CW_BACK_PIXEL | XCB_CW_BORDER_PIXEL | XCB_CW_OVERRIDE_REDIRECT | XCB_CW_EVENT_MASK | XCB_CW_COLORMAP, &attribute.backgroundColor), "could not create window", XCB_NONE);
		{
			uint32 gcData[3];
			requestCheck(xcb_open_font_checked(connection, font, LITERAL_LENGTH("fixed"), "fixed"), "could not open font", XCB_NONE);
			*(gcData + 0) = foreground;
			*(gcData + 1) = background;
			*(gcData + 2) = font;
			requestCheck(xcb_create_gc_checked(connection, gc, window, XCB_GC_FOREGROUND | XCB_GC_BACKGROUND | XCB_GC_FONT, gcData), "could not create graphics context", XCB_NONE);
		}
		jmp acquireFontMetrics;
	}
	acquireFontMetrics:{
		xcb_query_font_reply_t *reply = xcb_query_font_reply(connection, xcb_query_font(connection, font), NULL);
		if(reply){
			fontX      = (*reply).min_bounds.left_side_bearing;
			fontY      = (*reply).font_ascent;
			fontWidth  = (*reply).max_bounds.right_side_bearing - (*reply).min_bounds.left_side_bearing;
			fontHeight = (*reply).max_bounds.ascent + (*reply).max_bounds.descent;
			free(reply);
			reply = NULL;
		}
		jmp expressErrors;
	}
	expressErrors:{
		if(depth == 24){
			printError("could not use 32-bit depth, using 24-bit depth instead");
		}
		jmp eventLoop;
	}
	eventLoop:{
		xcb_flush(connection);
		free(event);
		event = NULL;
		jmp waitForEventLoop;
	}
	waitForEventLoop:{
		if((event = xcb_wait_for_event(connection))){
			jmp switchEvents;
		}
		if(xcb_connection_has_error(connection)){
			printConnectionError();
			jmp eventLoopExit;
		}
		jmp waitForEventLoop;
	}
	switchEvents:{
		#undef  XCB_RANDR_SCREEN_CHANGE_NOTIFY
		#define XCB_ONE /*------------------------*/ (1)
		#define XCB_RANDR_SCREEN_CHANGE_NOTIFY /*-*/ (89)
		printEvent();
		switch (*event).response_type & ~0x80 over
			to XCB_NONE: /*-----------------------*/ jmp errorEvent;
			to XCB_ONE: /*------------------------*/ jmp unexpectedEvent;
			to XCB_KEY_PRESS: /*------------------*/ jmp unexpectedEvent;
			to XCB_KEY_RELEASE: /*----------------*/ jmp unexpectedEvent;
			to XCB_BUTTON_PRESS: /*---------------*/ jmp unexpectedEvent;
			to XCB_BUTTON_RELEASE: /*-------------*/ jmp unexpectedEvent;
			to XCB_MOTION_NOTIFY: /*--------------*/ jmp unexpectedEvent;
			to XCB_ENTER_NOTIFY: /*---------------*/ jmp unexpectedEvent;
			to XCB_LEAVE_NOTIFY: /*---------------*/ jmp unexpectedEvent;
			to XCB_FOCUS_IN: /*-------------------*/ jmp unexpectedEvent;
			to XCB_FOCUS_OUT: /*------------------*/ jmp unexpectedEvent;
			to XCB_KEYMAP_NOTIFY: /*--------------*/ jmp unexpectedEvent;
			to XCB_EXPOSE: /*---------------------*/ jmp exposeEvent;
			to XCB_GRAPHICS_EXPOSURE: /*----------*/ jmp unexpectedEvent;
			to XCB_NO_EXPOSURE: /*----------------*/ jmp unexpectedEvent;
			to XCB_VISIBILITY_NOTIFY: /*----------*/ jmp unexpectedEvent;
			to XCB_CREATE_NOTIFY: /*--------------*/ jmp unexpectedEvent;
			to XCB_DESTROY_NOTIFY: /*-------------*/ jmp unexpectedEvent;
			to XCB_UNMAP_NOTIFY: /*---------------*/ jmp unexpectedEvent;
			to XCB_MAP_NOTIFY: /*-----------------*/ jmp unexpectedEvent;
			to XCB_MAP_REQUEST: /*----------------*/ jmp unexpectedEvent;
			to XCB_REPARENT_NOTIFY: /*------------*/ jmp unexpectedEvent;
			to XCB_CONFIGURE_NOTIFY: /*-----------*/ jmp unexpectedEvent;
			to XCB_CONFIGURE_REQUEST: /*----------*/ jmp unexpectedEvent;
			to XCB_GRAVITY_NOTIFY: /*-------------*/ jmp unexpectedEvent;
			to XCB_RESIZE_REQUEST: /*-------------*/ jmp unexpectedEvent;
			to XCB_CIRCULATE_NOTIFY: /*-----------*/ jmp unexpectedEvent;
			to XCB_CIRCULATE_REQUEST: /*----------*/ jmp unexpectedEvent;
			to XCB_PROPERTY_NOTIFY: /*------------*/ jmp unexpectedEvent;
			to XCB_SELECTION_CLEAR: /*------------*/ jmp unexpectedEvent;
			to XCB_SELECTION_REQUEST: /*----------*/ jmp unexpectedEvent;
			to XCB_SELECTION_NOTIFY: /*-----------*/ jmp unexpectedEvent;
			to XCB_COLORMAP_NOTIFY: /*------------*/ jmp unexpectedEvent;
			to XCB_CLIENT_MESSAGE: /*-------------*/ jmp unexpectedEvent;
			to XCB_MAPPING_NOTIFY: /*-------------*/ jmp eventLoop;
			to XCB_GE_GENERIC: /*-----------------*/ jmp unexpectedEvent;
			to XCB_RANDR_SCREEN_CHANGE_NOTIFY: /*-*/ jmp unexpectedEvent;
			off: /*-------------------------------*/ jmp unexpectedEvent;
		end
		#undef  XCB_RANDR_SCREEN_CHANGE_NOTIFY
		#undef  XCB_ONE
	}
	errorEvent:{
		genericError = (void *)event;
		printXCBError();
		genericError = NULL;
		jmp eventLoop;
	}
	exposeEvent:{
		/*!char soundNameLeft[256];
		char soundNameRight[256];*/
		exposeEventInner:{
			uint localVolume = volume;
			Texture t;
			xcb_get_image_reply_t *reply;
			t.width = width;
			t.height = height;
			t.size = width * height * 4;
			t.data = data;
			reply = xcb_get_image_reply(connection, xcb_get_image(connection, XCB_IMAGE_FORMAT_Z_PIXMAP, (*screen).root, x, y - height, width, height, -1), NULL);

			/*! sprintf(soundNameLeft, "%d%%", volume);
			sprintf(soundNameRight, "%d%%", volume); */

			if(localVolume > 100){
				localVolume = 100;
			}
			if(reply){
				doubleBoxBlur(width, height, (void *)xcb_get_image_data(reply), intermediateData, data, BOX_SIZE);
				filterTexture(wallpaper, t);
				free(reply);
			}
			{
				Texture texture;
				if(mute){
					texture = case0;
				}elif(volume == oldVolume){
					texture = case1;
				}elif(volume > oldVolume){
					texture = case2;
				}else{
					texture = case3;
				}
				realApplyTexture1(texture, t);
			}
			{
				const uint largePercentage = (100 - localVolume) * barOverlay.height / 100;
				realApplyTexture1WithXY(0, largePercentage, 0, (t.height - barOverlay.height) / 2 + largePercentage, barOverlay, t);
			}
			xcb_put_image(connection, XCB_IMAGE_FORMAT_Z_PIXMAP, window, gc, width, height, 0, 0, 0, depth, t.size, (void *)t.data);
			/*!xcb_image_text_8_checked(connection, LITERAL_LENGTH(left), window, gc, fontX + 10, fontY + 10 + 2 * fontHeight, left);
			xcb_image_text_8_checked(connection, strlen(soundNameLeft), window, gc, fontX + 10, fontY + 10 + 3 * fontHeight, soundNameLeft);
			xcb_image_text_8_checked(connection, LITERAL_LENGTH(right), window, gc, fontX + 10, fontY + 10 + 4 * fontHeight, right);
			xcb_image_text_8_checked(connection, strlen(soundNameRight), window, gc, fontX + 10, fontY + 10 + 5 * fontHeight, soundNameRight);*/
			xcb_flush(connection);
			if(time(NULL) - seconds >= duration){
				xcb_unmap_window(connection, window);
				xcb_flush(connection);
				jmp eventLoop;
			}
		}
		jmp exposeEventInner;
	}
	unexpectedEvent:{
		printUnexpectedEvent();
		jmp eventLoop;
	}
	eventLoopExit:{
		free(event);
		event = NULL;
		jmp mainEmergencyExit;
	}
	mainEmergencyExit:{
		xcb_disconnect(connection);
		connection = NULL;
		ret 0;
	}
}
PRINTERROR_DEC{
	if(openErrorStream()){
		fprintf(errorStream, "%s: %s\n", programName, string);
		closeErrorStream();
	}
	ret;
}
OPENERRORSTREAM_DEC{
	ret !mustOpenErrorStream or (errorStream = fopen(errorPath, "a"));
}
CLOSEERRORSTREAM_DEC{
	if(mustOpenErrorStream and errorStream){
		fclose(errorStream);
		errorStream = NULL;
	}
	ret;
}
PRINTCONNECTIONERROR_DEC{
	if(openErrorStream()){
		#define PRINTCONNECTIONERROR_ERROR /*--*/ xcb_connection_has_error(connection)
		#define PRINTCONNECTIONERROR_STREAM /*-*/ errorStream
		#include "xcb/printConnectionError.hold"
		closeErrorStream();
	}
	ret;
}
REQUESTCHECK_DEC{
	if(!(genericError = xcb_request_check(connection, c))){
		ret;
	}
	if(errorCode != XCB_NONE and (*genericError).error_code == errorCode){
		printError(errorMessage);
	}else{
		printXCBError();
	}
	free(genericError);
	genericError = NULL;
	ret;
}
#if DEBUG
PRINTEVENT_DEC{
	#define PRINTEVENT_EVENT /*--*/ event
	#define PRINTEVENT_STREAM /*-*/ stdout
	#include "xcb/printEvent.hold"
	ret;
}
#endif
PRINTXCBERROR_DEC{
	if(openErrorStream()){
		#define PRINTXCBERROR_ERROR /*--*/ genericError
		#define PRINTXCBERROR_STREAM /*-*/ errorStream
		#include "xcb/printXCBError.hold"
		closeErrorStream();
	}
	ret;
}
#if DEBUG
PRINTUNEXPECTEDEVENT_DEC{
	if(openErrorStream()){
		#define PRINTUNEXPECTEDEVENT_EVENT /*--*/ event
		#define PRINTUNEXPECTEDEVENT_STREAM /*-*/ errorStream
		#include "xcb/printUnexpectedEvent.hold"
		closeErrorStream();
	}
	ret;
}
#endif
void doubleBoxBlur(const int width, const int height, uint32 *originalData, uint32 *intermediateData, uint32 *destinationData, const int boxSize){
	const int divisor = boxSize * boxSize;
	const int boxDistanceFromZero = boxSize >> 1;
	const int nBoxDistanceFromZero = -boxDistanceFromZero;
	const int widthMinusOne = width - 1;
	const int heightMinusOne = height - 1;
	const int heightMinusBoxSize = height - boxSize;
	uint32 *tx = originalData;
	uint32 *txCopy = tx;
	uint32 *rx = intermediateData;
	uint32 r;
	uint32 g;
	uint32 b;
	loop:{
		uint32 *kernelColumnRCurrent = kernelColumnRStart;
		uint32 *kernelColumnGCurrent = kernelColumnGStart;
		uint32 *kernelColumnBCurrent = kernelColumnBStart;
		uint32 *kernelColumnRCurrentCopy = kernelColumnRStart;
		uint32 *kernelColumnGCurrentCopy = kernelColumnGStart;
		uint32 *kernelColumnBCurrentCopy = kernelColumnBStart;
		uint32 *pixelRCurrent = pixelRStart;
		uint32 *pixelGCurrent = pixelGStart;
		uint32 *pixelBCurrent = pixelBStart;
		uint32 *pixelRCurrentCopy = pixelRStart;
		uint32 *pixelGCurrentCopy = pixelGStart;
		uint32 *pixelBCurrentCopy = pixelBStart;
		int x = 0;
		int y = 0;
		{
			int kx = nBoxDistanceFromZero;
			r = 0;
			g = 0;
			b = 0;
			while(kx <= boxDistanceFromZero){
				int ky = nBoxDistanceFromZero;
				int usedX = x + kx;
				if(usedX < 0){
					usedX = 0;
				}
				*kernelColumnRCurrent = 0;
				*kernelColumnGCurrent = 0;
				*kernelColumnBCurrent = 0;
				tx += usedX;
				while(ky <= boxDistanceFromZero){
					int usedY = y + ky;
					uint32 color;
					if(usedY < 0){
						usedY = 0;
					}
					color = *(tx + usedY * width);
					*pixelRCurrent = (color & 0xFF0000) >> 16;
					*pixelGCurrent = (color & 0x00FF00) >>  8;
					*pixelBCurrent =  color & 0x0000FF;
					*kernelColumnRCurrent += *pixelRCurrent;
					*kernelColumnGCurrent += *pixelGCurrent;
					*kernelColumnBCurrent += *pixelBCurrent;
					inc pixelRCurrent;
					inc pixelGCurrent;
					inc pixelBCurrent;
					inc ky;
				}
				tx -= usedX;
				r += *kernelColumnRCurrent;
				g += *kernelColumnGCurrent;
				b += *kernelColumnBCurrent;
				pixelRCurrent += heightMinusBoxSize;
				pixelGCurrent += heightMinusBoxSize;
				pixelBCurrent += heightMinusBoxSize;
				inc kernelColumnRCurrent;
				inc kernelColumnGCurrent;
				inc kernelColumnBCurrent;
				inc kx;
			}
			*rx = 0xFF000000 + ((r / divisor) << 16) + ((g / divisor) << 8) + b / divisor;
			inc rx;
		}
		inc x;
		xFirstLoop:{
			int kx = boxDistanceFromZero;
			int ky = nBoxDistanceFromZero;
			int usedX = x + kx;
			if(usedX < 0){
				usedX = 0;
			}elif(usedX >= width){
				usedX = widthMinusOne;
			}
			r -= *kernelColumnRCurrentCopy;
			g -= *kernelColumnGCurrentCopy;
			b -= *kernelColumnBCurrentCopy;
			kernelColumnRCurrent = kernelColumnRCurrentCopy + boxSize;
			kernelColumnGCurrent = kernelColumnGCurrentCopy + boxSize;
			kernelColumnBCurrent = kernelColumnBCurrentCopy + boxSize;
			inc kernelColumnRCurrentCopy;
			inc kernelColumnGCurrentCopy;
			inc kernelColumnBCurrentCopy;
			{
				uint32 lr = 0;
				uint32 lg = 0;
				uint32 lb = 0;
				tx += usedX;
				while(ky <= boxDistanceFromZero){
					int usedY = y + ky;
					uint32 color;
					if(usedY < 0){
						usedY = 0;
					}elif(usedY >= height){
						usedY = heightMinusOne;
					}
					color = *(tx + usedY * width);
					*pixelRCurrent = (color & 0xFF0000) >> 16;
					*pixelGCurrent = (color & 0x00FF00) >>  8;
					*pixelBCurrent =  color & 0x0000FF;
					lr += *pixelRCurrent;
					lg += *pixelGCurrent;
					lb += *pixelBCurrent;
					inc pixelRCurrent;
					inc pixelGCurrent;
					inc pixelBCurrent;
					inc ky;
				}
				tx -= usedX;
				r += lr;
				g += lg;
				b += lb;
				*kernelColumnRCurrent = lr;
				*kernelColumnGCurrent = lg;
				*kernelColumnBCurrent = lb;
				pixelRCurrent += heightMinusBoxSize;
				pixelGCurrent += heightMinusBoxSize;
				pixelBCurrent += heightMinusBoxSize;
			}
			*rx = 0xFF000000 + ((r / divisor) << 16) + ((g / divisor) << 8) + b / divisor;
			inc rx;
			if(inc x < width){
				jmp xFirstLoop;
			}
		}
		inc y;
		yLoop:{
			uint32 *pr;
			uint32 *pg;
			uint32 *pb;
			int ky = boxDistanceFromZero;
			int usedY = y + ky;
			if(usedY < 0){
				usedY = 0;
			}elif(usedY >= height){
				usedY = heightMinusOne;
			}
			x = 0;
			{
				int kx = nBoxDistanceFromZero;
				kernelColumnRCurrent = kernelColumnRStart;
				kernelColumnGCurrent = kernelColumnGStart;
				kernelColumnBCurrent = kernelColumnBStart;
				kernelColumnRCurrentCopy = kernelColumnRStart;
				kernelColumnGCurrentCopy = kernelColumnGStart;
				kernelColumnBCurrentCopy = kernelColumnBStart;
				pixelRCurrent = pixelRCurrentCopy;
				pixelGCurrent = pixelGCurrentCopy;
				pixelBCurrent = pixelBCurrentCopy;
				pr = pixelRCurrent + boxSize;
				pg = pixelGCurrent + boxSize;
				pb = pixelBCurrent + boxSize;
				r = 0;
				g = 0;
				b = 0;
				tx += usedY * width;
				while(kx <= boxDistanceFromZero){
					int usedX = x + kx;
					uint32 color;
					if(usedX < 0){
						usedX = 0;
					}elif(usedX >= width){
						usedX = widthMinusOne;
					}
					color = *(tx + usedX);
					*pr = (color & 0xFF0000) >> 16;
					*pg = (color & 0x00FF00) >>  8;
					*pb =  color & 0x0000FF;
					*kernelColumnRCurrent += *pr - *pixelRCurrent;
					*kernelColumnGCurrent += *pg - *pixelGCurrent;
					*kernelColumnBCurrent += *pb - *pixelBCurrent;
					r += *kernelColumnRCurrent;
					g += *kernelColumnGCurrent;
					b += *kernelColumnBCurrent;
					pixelRCurrent += height;
					pixelGCurrent += height;
					pixelBCurrent += height;
					pr += height;
					pg += height;
					pb += height;
					inc kernelColumnRCurrent;
					inc kernelColumnGCurrent;
					inc kernelColumnBCurrent;
					inc kx;
				}
				tx -= usedY * width;
				*rx = 0xFF000000 + ((r / divisor) << 16) + ((g / divisor) << 8) + b / divisor;
				inc rx;
				inc x;
			}
			{
				int usedX = x + boxDistanceFromZero;
				usedY *= width;
				tx += usedY;
				xLoop:{
					uint32 color;
					if(usedX >= width){
						usedX = widthMinusOne;
					}
					kernelColumnRCurrent = kernelColumnRCurrentCopy + boxSize;
					kernelColumnGCurrent = kernelColumnGCurrentCopy + boxSize;
					kernelColumnBCurrent = kernelColumnBCurrentCopy + boxSize;
					r -= *kernelColumnRCurrentCopy;
					g -= *kernelColumnGCurrentCopy;
					b -= *kernelColumnBCurrentCopy;
					color = *(tx + usedX);
					*pr = (color & 0xFF0000) >> 16;
					*pg = (color & 0x00FF00) >>  8;
					*pb =  color & 0x0000FF;
					*kernelColumnRCurrent += *pr - *pixelRCurrent;
					*kernelColumnGCurrent += *pg - *pixelGCurrent;
					*kernelColumnBCurrent += *pb - *pixelBCurrent;
					r += *kernelColumnRCurrent;
					g += *kernelColumnGCurrent;
					b += *kernelColumnBCurrent;
					inc kernelColumnRCurrentCopy;
					inc kernelColumnGCurrentCopy;
					inc kernelColumnBCurrentCopy;
					pixelRCurrent += height;
					pixelGCurrent += height;
					pixelBCurrent += height;
					pr += height;
					pg += height;
					pb += height;
					*rx = 0xFF000000 + ((r / divisor) << 16) + ((g / divisor) << 8) + b / divisor;
					inc rx;
					if(inc x < width){
						inc usedX;
						jmp xLoop;
					}
				}
				tx -= usedY;
			}
			if(inc y < height){
				inc pixelRCurrentCopy;
				inc pixelGCurrentCopy;
				inc pixelBCurrentCopy;
				jmp yLoop;
			}
		}
		if(txCopy == originalData){
			tx = intermediateData;
			txCopy = tx;
			rx = destinationData;
			jmp loop;
		}
	}
	ret;
}
PULSEAUDIOSTART(){
	(void)arg;
	mainloop = pa_mainloop_new();
	api = pa_mainloop_get_api(mainloop);
	context = pa_context_new(api, "microsound");
	{
		if(pa_context_connect(context, NULL, PA_CONTEXT_NOFLAGS, NULL) == -1){
			fprintf(stdout, "bad connect\n");
		}
	}
	{
		#define PA_CONTEXT_NONE /*-*/ (0)
		uint ready = PA_CONTEXT_NONE;
		pa_context_set_state_callback(context, getState, &ready);
		readyUp:{
			pa_mainloop_prepare(mainloop, -1);
			pa_mainloop_poll(mainloop);
			pa_mainloop_dispatch(mainloop);
			switch ready over
				to PA_CONTEXT_NONE: /*-------*/ /*----------------------------------*/ jmp readyUp;
				to PA_CONTEXT_READY: /*------*/ /*----------------------------------*/ brk;
				to PA_CONTEXT_TERMINATED: /*-*/ fprintf(stdout, "terminated\n"); /*-*/ jmp emergencyExit;
				off: /*----------------------*/ fprintf(stdout, "failed\n"); /*-----*/ jmp emergencyExit;
			end
		}
		#undef  PA_CONTEXT_NONE
	}
	{
		pa_operation *operation = pa_context_get_server_info(context, getSinkName, NULL);
		pa_operation_unref(operation);
	}
	{
		pa_operation *operation = pa_context_get_sink_info_by_name(context, defaultSinkName, firstGetSinkInfo, NULL);
		pa_operation_unref(operation);
	}
	{
		pa_operation *operation = pa_context_subscribe(context, PA_SUBSCRIPTION_MASK_SINK, NULL, NULL);
		pa_context_set_subscribe_callback(context, subscribeCallback, NULL);
		pa_operation_unref(operation);
	}
	{
		pa_mainloop_run(mainloop, NULL);
	}
	emergencyExit:{
		pa_context_disconnect(context);
		pa_context_unref(context);
		pa_mainloop_free(mainloop);
		ret NULL;
	}
}
GETSTATE(){
	switch pa_context_get_state(context) over
		to PA_CONTEXT_UNCONNECTED: /*--*/ /*--------------------------------------------*/ ret;
		to PA_CONTEXT_CONNECTING: /*---*/ /*--------------------------------------------*/ ret;
		to PA_CONTEXT_AUTHORIZING: /*--*/ /*--------------------------------------------*/ ret;
		to PA_CONTEXT_SETTING_NAME: /*-*/ /*--------------------------------------------*/ ret;
		to PA_CONTEXT_READY: /*--------*/ *(uint *)userdata = PA_CONTEXT_READY; /*------*/ ret;
		to PA_CONTEXT_FAILED: /*-------*/ *(uint *)userdata = PA_CONTEXT_FAILED; /*-----*/ ret;
		to PA_CONTEXT_TERMINATED: /*---*/ *(uint *)userdata = PA_CONTEXT_TERMINATED; /*-*/ ret;
		off: /*------------------------*/ *(uint *)userdata = PA_CONTEXT_FAILED; /*-----*/ ret;
	end
}
SUBSCRIBECALLBACK(){
	(void)context;
	(void)idx;
	(void)userdata;
#ifdef DEBUG
	if((event & PA_SUBSCRIPTION_EVENT_TYPE_MASK) == PA_SUBSCRIPTION_EVENT_NEW){
		fprintf(stdout, "PA_SUBSCRIPTION_EVENT_NEW\n");
	}
	if((event & PA_SUBSCRIPTION_EVENT_TYPE_MASK) == PA_SUBSCRIPTION_EVENT_CHANGE){
		fprintf(stdout, "PA_SUBSCRIPTION_EVENT_CHANGE\n");
	}
	if((event & PA_SUBSCRIPTION_EVENT_TYPE_MASK) == PA_SUBSCRIPTION_EVENT_REMOVE){
		fprintf(stdout, "PA_SUBSCRIPTION_EVENT_REMOVE\n");
	}
#endif
	if((event & PA_SUBSCRIPTION_EVENT_FACILITY_MASK) == PA_SUBSCRIPTION_EVENT_SINK){
		if((event & PA_SUBSCRIPTION_EVENT_TYPE_MASK) == PA_SUBSCRIPTION_EVENT_NEW){
			pa_operation *operation = pa_context_get_server_info(context, getSinkName, NULL);
			pa_operation_unref(operation);
			ret;
		}
		if((event & PA_SUBSCRIPTION_EVENT_TYPE_MASK) == PA_SUBSCRIPTION_EVENT_REMOVE){
			pa_operation *operation = pa_context_get_server_info(context, getSinkName, NULL);
			pa_operation_unref(operation);
			ret;
		}
		if((event & PA_SUBSCRIPTION_EVENT_TYPE_MASK) == PA_SUBSCRIPTION_EVENT_CHANGE){
			pa_operation *operation = pa_context_get_sink_info_by_name(context, defaultSinkName, getSinkInfo, NULL);
			pa_operation_unref(operation);
			ret;
		}
	}
	ret;
}
GETSINKNAME(){
	(void)context;
	(void)userdata;
	defaultSinkName = (*si).default_sink_name;
	ret;
}
FIRSTGETSINKINFO(){
	(void)context;
	(void)userdata;
	if(eol < 0){
		fprintf(stdout, "get initial sink info problem\n");
		ret;
	}
	if(!eol){
		const int newVolume = (pa_cvolume_avg(&(*si).volume) + 1) * 100 / PA_VOLUME_NORM;
		const bool newMute = (*si).mute;
		volume = newVolume;
		mute = newMute;
		oldVolume = newVolume;
		oldMute = newMute;
		ret;
	}
	ret;
}
GETSINKINFO(){
	(void)context;
	(void)userdata;
	if(eol < 0){
		fprintf(stdout, "get sink info problem\n");
		ret;
	}
	if(!eol){
		const int newVolume = (pa_cvolume_avg(&(*si).volume) + 1) * 100 / PA_VOLUME_NORM;
		const bool newMute = (*si).mute;
		if(newVolume != volume or newMute != mute){
			oldVolume = volume;
			oldMute = mute;
			volume = newVolume;
			mute = newMute;
			xcb_configure_window(connection, window, XCB_CONFIG_WINDOW_STACK_MODE, &stackMode);
			xcb_map_window(connection, window);
			xcb_flush(connection);
			seconds = time(NULL);
		}
		ret;
	}
	/*! pa_mainloop_quit(mainloop, 0); */
	ret;
}

