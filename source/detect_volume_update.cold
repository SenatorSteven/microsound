#include <stdio.h>
#include <pulse/simple.h>
#include <pulse/error.h>
#include <pulse/mainloop.h>
#include <cold/cold.h>

const char *programName = NULL;

void volume_change_callback(pa_context *c, const pa_sink_info *info, int eol, void *userdata) {
    if (eol < 0) {
        fprintf(stderr, "Error: %s\n", pa_strerror(pa_context_errno(c)));
        return;
    }

    if (info != NULL) {
        printf("Sink Name: %s\n", info->name);
        printf("Volume: %f\n", pa_cvolume_avg(&info->volume) / (double)PA_VOLUME_NORM);
    }
}

int main(const int argumentAmount, const char *const *argument) {
    programName = argument[0];

    pa_mainloop* mainloop = NULL;
    pa_mainloop_api* mainloop_api = NULL;
    pa_context* context = NULL;

    mainloop = pa_mainloop_new();
    if (!mainloop) {
        fprintf(stderr, "pa_mainloop_new() failed.\n");
        return 1;
    }
    
    mainloop_api = pa_mainloop_get_api(mainloop);
    context = pa_context_new(mainloop_api, programName);
    if (!context) {
        fprintf(stderr, "pa_context_new() failed.\n");
        return 1;
    }

    if (pa_context_connect(context, NULL, 0, NULL) < 0) {
        fprintf(stderr, "pa_context_connect() failed: %s\n", pa_strerror(pa_context_errno(context)));
        return 1;
    }

    pa_context_set_state_callback(context, volume_change_callback, NULL);
    pa_context_get_sink_info_by_name(context, pa_stream_get_device_name(NULL), volume_change_callback, NULL);

    if (pa_mainloop_run(mainloop, NULL) < 0) {
        fprintf(stderr, "pa_mainloop_run() failed.\n");
        return 1;
    }

    pa_context_disconnect(context);
    pa_context_unref(context);
    pa_mainloop_free(mainloop);

    return 0;
}

